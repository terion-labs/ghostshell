<Project InitialTargets="RequireExistingRuntimeLockForLockedRestore;RequireLockedRestoreForSelfContainedDesktopPackage">
  <!-- A missing runtime-specific lock is otherwise created even when NuGet is
       asked for locked mode. Reject that state while each restore graph entry
       is evaluated, before package resolution can update the source tree. -->
  <Target
      Name="RequireExistingRuntimeLockForLockedRestore"
      BeforeTargets="_GenerateRestoreGraphProjectEntry;Restore"
      Condition="('$(RuntimeIdentifier)' != '' or '$(RuntimeIdentifiers)' != '') and '$(RestoreLockedMode)' == 'true' and ('$(AsuraFirstPartyProject)' == 'True' or '$(AsuraVendoredLockedProject)' == 'true' or '$(MSBuildProjectName)' == 'Asura.Desktop')">
    <ItemGroup>
      <AsuraExpectedRuntimeLock
          Include="$([System.IO.Path]::GetFullPath('packages.$(RuntimeIdentifier).lock.json', '$(MSBuildProjectDirectory)'))"
          Condition="'$(RuntimeIdentifier)' != '' and !('$(MSBuildProjectName)' == 'Asura.Desktop' and '$(AsuraMacReleaseNativeAot)' == 'true')" />
      <AsuraExpectedRuntimeLock
          Include="$([System.IO.Path]::GetFullPath('packages.$(RuntimeIdentifier).aot.lock.json', '$(MSBuildProjectDirectory)'))"
          Condition="'$(RuntimeIdentifier)' != '' and '$(MSBuildProjectName)' == 'Asura.Desktop' and '$(AsuraMacReleaseNativeAot)' == 'true'" />
      <AsuraExpectedRuntimeLock
          Include="$([System.IO.Path]::GetFullPath('packages.$(RuntimeIdentifiers).lock.json', '$(MSBuildProjectDirectory)'))"
          Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' != '' and !$([System.String]::Copy('$(RuntimeIdentifiers)').Contains(';'))" />
      <AsuraSelectedRuntimeLock
          Include="$([System.IO.Path]::GetFullPath('$(NuGetLockFilePath)', '$(MSBuildProjectDirectory)'))"
          Condition="'$(NuGetLockFilePath)' != ''" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Asura.Desktop'">
      <AsuraRuntimeLockProject Include="$(MSBuildThisFileDirectory)src/Asura.*/*.csproj" />
      <AsuraRequiredRuntimeLock
          Include="@(AsuraRuntimeLockProject->'%(RootDir)%(Directory)packages.$(RuntimeIdentifier).lock.json')"
          Condition="'$(RuntimeIdentifier)' != ''" />
      <AsuraRequiredRuntimeLock
          Include="@(AsuraRuntimeLockProject->'%(RootDir)%(Directory)packages.$(RuntimeIdentifiers).lock.json')"
          Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' != '' and !$([System.String]::Copy('$(RuntimeIdentifiers)').Contains(';'))" />
    </ItemGroup>
    <Error
        Condition="'$(RuntimeIdentifier)' == '' and $([System.String]::Copy('$(RuntimeIdentifiers)').Contains(';'))"
        Text="Locked restore for $(MSBuildProjectName) requires one reviewed runtime identifier at a time; received $(RuntimeIdentifiers)." />
    <Error
        Condition="'$(NuGetLockFilePath)' == ''"
        Text="Locked restore for $(MSBuildProjectName) requires NuGetLockFilePath to select @(AsuraExpectedRuntimeLock->'%(Filename)%(Extension)')." />
    <Error
        Condition="'$(NuGetLockFilePath)' != '' and '@(AsuraSelectedRuntimeLock)' != '@(AsuraExpectedRuntimeLock)'"
        Text="Locked restore for $(MSBuildProjectName) requires the reviewed runtime lock path @(AsuraExpectedRuntimeLock); received @(AsuraSelectedRuntimeLock)." />
    <Error
        Condition="!Exists('@(AsuraExpectedRuntimeLock)')"
        Text="Locked restore for $(MSBuildProjectName) requires the reviewed runtime lock @(AsuraExpectedRuntimeLock)." />
    <Error
        Condition="'$(MSBuildProjectName)' == 'Asura.Desktop' and !Exists('%(AsuraRequiredRuntimeLock.Identity)')"
        Text="Locked restore for Asura.Desktop requires the complete reviewed runtime-lock closure; missing %(AsuraRequiredRuntimeLock.Identity)." />
  </Target>

  <Target
      Name="RequireLockedRestoreForSelfContainedDesktopPackage"
      DependsOnTargets="RequireExistingRuntimeLockForLockedRestore"
      BeforeTargets="_GenerateRestoreGraphProjectEntry;Restore;PrepareForBuild;Publish"
      Condition="'$(MSBuildProjectName)' == 'Asura.Desktop' and '$(SelfContained)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(RestoreForceEvaluate)' != 'true'">
    <Error
        Condition="'$(RuntimeIdentifier)' == ''"
        Text="Self-contained Asura.Desktop packaging requires an explicit RuntimeIdentifier and its reviewed packages.&lt;RID&gt;.lock.json closure." />
    <Error
        Condition="'$(RestoreLockedMode)' != 'true'"
        Text="Self-contained Asura.Desktop packaging requires RestoreLockedMode=true and a prior locked restore using $(NuGetLockFilePath)." />
  </Target>

  <!-- The source seal is consumed by the compiler, not added after packaging.
       The release script also verifies the same manifest immediately around
       compilation while the exported source root is read-only. -->
  <Target
      Name="RequireValidReleaseSourceManifestIdentity"
      BeforeTargets="CoreCompile"
      Condition="'$(AsuraFirstPartyProject)' == 'True' and '$(AsuraReleaseSourceManifestSha256)' != ''">
    <Error
        Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(AsuraReleaseSourceManifestSha256)', '^[0-9a-f]{64}$'))"
        Text="AsuraReleaseSourceManifestSha256 must be an exact lowercase SHA-256 digest." />
  </Target>
</Project>
