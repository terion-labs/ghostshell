<Project>
  <!-- Test-only upstream TDS server boundary. Production SqlClient comes from
       NuGet; Asura drivers and assertions retain first-party analyzers. -->
  <PropertyGroup>
    <AsuraVendoredTestProject>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'tests/Tds.TestSupport.csproj'))</AsuraVendoredTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectFullPath)' == '$(AsuraVendoredTestProject)'">
    <!-- Share the repository's runtime-lock validation without first-party analyzers. -->
    <AsuraVendoredLockedProject>true</AsuraVendoredLockedProject>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' != ''">packages.$(RuntimeIdentifiers).lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
