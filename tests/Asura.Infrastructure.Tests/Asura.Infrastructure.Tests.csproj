<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SecurityCampaignCanaries.cs"
             Link="Shared\SecurityCampaignCanaries.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Asura.Infrastructure\Asura.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Asura.Terminal\Asura.Terminal.csproj" />
    <ProjectReference
      Include="..\..\tools\Asura.SqlLanguageTestWorker\Asura.SqlLanguageTestWorker.csproj"
      OutputItemType="_SqlLanguageTestWorkerTargetPath"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../native/artifacts/linux-arm64/workspace-gateway')">
    <Content
      Include="$(MSBuildThisFileDirectory)../../native/artifacts/linux-arm64/workspace-gateway"
      Link="runtimes/linux-arm64/guest/workspace-gateway"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target
    Name="AddSqlLanguageTestWorkerPath"
    BeforeTargets="GetAssemblyAttributes"
    DependsOnTargets="ResolveProjectReferences">
    <Error
      Condition="'@(_SqlLanguageTestWorkerTargetPath)' == ''"
      Text="The SQL language test worker target path was not resolved." />
    <ItemGroup>
      <AssemblyMetadata Include="SqlLanguageTestWorkerPath">
        <Value>@(_SqlLanguageTestWorkerTargetPath->'%(FullPath)')</Value>
      </AssemblyMetadata>
    </ItemGroup>
  </Target>

</Project>
