<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GhostShellWindowsBuild Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">true</GhostShellWindowsBuild>
    <GhostShellWindowsBuild Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</GhostShellWindowsBuild>
    <NuGetLockFilePath Condition="'$(GhostShellWindowsBuild)' == 'true' and '$(RuntimeIdentifier)' == ''">packages.windows.lock.json</NuGetLockFilePath>
    <TargetFramework Condition="'$(GhostShellWindowsBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(GhostShellWindowsBuild)' != 'true'">net10.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(GhostShellWindowsBuild)' == 'true'">10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting Condition="'$(GhostShellWindowsBuild)' == 'true'">true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="..\GhostShell.App.Tests\ApplicationViewCatalog.cs"
      Link="ApplicationViewCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\sqlclient\tests\Tds.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\GhostShell.Agent\GhostShell.Agent.csproj" />
    <ProjectReference Include="..\..\src\GhostShell.Agent.Providers\GhostShell.Agent.Providers.csproj" />
    <ProjectReference Include="..\..\src\GhostShell.Agent.Runtime\GhostShell.Agent.Runtime.csproj" />
    <ProjectReference Include="..\..\src\GhostShell.Desktop\GhostShell.Desktop.csproj" />
    <ProjectReference
      Include="..\..\tools\GhostShell.SingleInstanceTestHost\GhostShell.SingleInstanceTestHost.csproj"
      OutputItemType="_SingleInstanceTestHostTargetPath"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target
    Name="AddSingleInstanceTestHostPath"
    BeforeTargets="GetAssemblyAttributes"
    DependsOnTargets="ResolveProjectReferences">
    <Error
      Condition="'@(_SingleInstanceTestHostTargetPath)' == ''"
      Text="The single-instance test host target path was not resolved." />
    <ItemGroup>
      <AssemblyMetadata Include="SingleInstanceTestHostPath">
        <Value>@(_SingleInstanceTestHostTargetPath->'%(FullPath)')</Value>
      </AssemblyMetadata>
    </ItemGroup>
  </Target>

</Project>
