<UserControl
    x:Class="GhostShell.App.Views.Components.NetworkCredentialPicker"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GhostShell.App.ViewModels"
    xmlns:controls="using:GhostShell.App.Controls"
    Focusable="False"
    HorizontalContentAlignment="Stretch">
  <!--
    One credential slot of a network connection: which stored credential fills
    it, and the way to add a new one to this slot. The connection editor has
    six of these across its five connection kinds, and each one used to be a
    settings row squeezed into half a grid column beside a two-step "store a
    credential" form that had to be told which slot it was for.
  -->
  <controls:LabeledField
      Label="{Binding Label, ElementName=Root}"
      Hint="{Binding Hint, ElementName=Root}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
      <ComboBox
          HorizontalAlignment="Stretch"
          ItemsSource="{Binding ItemsSource, ElementName=Root}"
          SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
          AutomationProperties.Name="{Binding Label, ElementName=Root}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NetworkCredentialOption">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
              <TextBlock
                  Classes="Muted"
                  FontSize="{DynamicResource ShellFontSize9}"
                  Text="{Binding Detail}"
                  TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button
          Grid.Column="1"
          Classes="SecondaryButton"
          Click="OnAddClick"
          Content="Add new…"
          AutomationProperties.Name="{Binding Label, ElementName=Root, StringFormat=Add a new {0}}" />
    </Grid>
  </controls:LabeledField>
</UserControl>
