<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.UnavailableRuntimePanelView"
    x:DataType="vm:UnavailableRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GhostShell.App.ViewModels"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <controls:PanelChrome
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:StateOverlay
        Kind="Unsupported"
        Heading="{Binding StateHeading}"
        ActionLabel="{Binding StateActionLabel}"
        ActionCommand="{Binding StateActionCommand}"
        Body="{Binding CapabilityMessage}" />
  </controls:PanelChrome>
</UserControl>
