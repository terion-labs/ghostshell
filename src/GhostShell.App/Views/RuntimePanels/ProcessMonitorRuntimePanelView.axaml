<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.ProcessMonitorRuntimePanelView"
    x:DataType="vm:ProcessMonitorRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GhostShell.App.ViewModels"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:runtimePanels="using:GhostShell.App.Views.RuntimePanels"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Process monitor panel"
    Container.Name="processPanel"
    Container.Sizing="Width">
  <UserControl.Styles>
    <!-- Below the width where all five columns fit, the Started column folds
         away. The panel's own width, not the window's: two panels can share
         one window, and this one answers only for itself. -->
    <ContainerQuery Name="processPanel" Query="max-width:560">
      <Style Selector="TextBlock.StartedCell">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>
    <Style Selector="Button.ProcessColumnHeader">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.ProcessColumnHeader /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.ProcessColumnHeader:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    </Style>
    <Style Selector="icons|SymbolIcon.ProcessSortIndicator">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="Button.ProcessColumnHeader.sorted TextBlock.Eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="Button.ProcessColumnHeader.sorted icons|SymbolIcon.ProcessSortAscending">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.ProcessColumnHeader.sorted.descending icons|SymbolIcon.ProcessSortAscending">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.ProcessColumnHeader.sorted.descending icons|SymbolIcon.ProcessSortDescending">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <controls:PanelChrome
      CloseLabel="Close Process Monitor panel"
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <Border Classes="StatusDot" Background="{Binding StatusColor}" />
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <controls:PanelChrome.Actions>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
        <controls:LiveRegionTextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize9}"
            Text="{Binding StatusText}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Process monitor state" />
        <Button
            Classes="IconButton"
            Command="{Binding RefreshCommand}"
            ToolTip.Tip="Refresh processes"
            AutomationProperties.Name="Refresh processes">
          <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellFontSize12}" />
        </Button>
      </StackPanel>
    </controls:PanelChrome.Actions>

    <controls:PanelChrome.Footer>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ShowingText}" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding CapturedAtText}" />
      </Grid>
    </controls:PanelChrome.Footer>

    <Grid RowDefinitions="46,28,*">
      <Border Grid.Row="0" Classes="PanelToolbar">
        <Grid Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}">
          <TextBox VerticalAlignment="Center" Text="{Binding Filter}" PlaceholderText="Filter by process name or PID" AutomationProperties.Name="Filter processes" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="PanelToolbar">
        <!-- Fixed-width cells docked from the right instead of grid columns:
             hiding a docked cell reclaims its width, so the Started column can
             fold away on narrow panels while every row stays aligned. -->
        <DockPanel Height="28" Margin="{controls:Inset Horizontal=Md}" LastChildFill="True">
          <Button
              DockPanel.Dock="Left"
              Width="70"
              Classes="ProcessColumnHeader"
              Classes.sorted="{Binding IsSortingByProcessId}"
              Classes.descending="{Binding IsSortDescending}"
              HorizontalContentAlignment="Left"
              VerticalContentAlignment="Center"
              Padding="0"
              Click="OnSortProcessIdClick"
              AutomationProperties.Name="Sort processes by PID">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="Eyebrow" Text="PID" />
              <icons:SymbolIcon Classes="ProcessSortIndicator ProcessSortAscending" FontSize="10" IsHitTestVisible="False" Symbol="ArrowUp" AutomationProperties.Name="Sorted ascending" />
              <icons:SymbolIcon Classes="ProcessSortIndicator ProcessSortDescending" FontSize="10" IsHitTestVisible="False" Symbol="ArrowDown" AutomationProperties.Name="Sorted descending" />
            </StackPanel>
          </Button>
          <TextBlock DockPanel.Dock="Right" Width="137" Margin="{controls:Inset Left=Sm}" VerticalAlignment="Center" Classes="Eyebrow StartedCell" Text="Started" />
          <Button
              DockPanel.Dock="Right"
              Width="110"
              Classes="ProcessColumnHeader"
              Classes.sorted="{Binding IsSortingByMemory}"
              Classes.descending="{Binding IsSortDescending}"
              HorizontalContentAlignment="Left"
              VerticalContentAlignment="Center"
              Padding="{controls:Inset Horizontal=Sm}"
              Click="OnSortMemoryClick"
              AutomationProperties.Name="Sort processes by memory">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="Eyebrow" Text="Memory" />
              <icons:SymbolIcon Classes="ProcessSortIndicator ProcessSortAscending" FontSize="10" IsHitTestVisible="False" Symbol="ArrowUp" AutomationProperties.Name="Sorted ascending" />
              <icons:SymbolIcon Classes="ProcessSortIndicator ProcessSortDescending" FontSize="10" IsHitTestVisible="False" Symbol="ArrowDown" AutomationProperties.Name="Sorted descending" />
            </StackPanel>
          </Button>
          <Button
              DockPanel.Dock="Right"
              Width="90"
              Classes="ProcessColumnHeader"
              Classes.sorted="{Binding IsSortingByCpu}"
              Classes.descending="{Binding IsSortDescending}"
              HorizontalContentAlignment="Left"
              VerticalContentAlignment="Center"
              Padding="{controls:Inset Horizontal=Sm}"
              Click="OnSortCpuClick"
              AutomationProperties.Name="Sort processes by CPU">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="Eyebrow" Text="CPU" />
              <icons:SymbolIcon Classes="ProcessSortIndicator ProcessSortAscending" FontSize="10" IsHitTestVisible="False" Symbol="ArrowUp" AutomationProperties.Name="Sorted ascending" />
              <icons:SymbolIcon Classes="ProcessSortIndicator ProcessSortDescending" FontSize="10" IsHitTestVisible="False" Symbol="ArrowDown" AutomationProperties.Name="Sorted descending" />
            </StackPanel>
          </Button>
          <Button
              Classes="ProcessColumnHeader"
              Classes.sorted="{Binding IsSortingByName}"
              Classes.descending="{Binding IsSortDescending}"
              HorizontalContentAlignment="Left"
              VerticalContentAlignment="Center"
              Padding="{controls:Inset Horizontal=Sm}"
              Click="OnSortNameClick"
              AutomationProperties.Name="Sort processes by name">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="Eyebrow" Text="Name" />
              <icons:SymbolIcon Classes="ProcessSortIndicator ProcessSortAscending" FontSize="10" IsHitTestVisible="False" Symbol="ArrowUp" AutomationProperties.Name="Sorted ascending" />
              <icons:SymbolIcon Classes="ProcessSortIndicator ProcessSortDescending" FontSize="10" IsHitTestVisible="False" Symbol="ArrowDown" AutomationProperties.Name="Sorted descending" />
            </StackPanel>
          </Button>
        </DockPanel>
      </Border>

      <Grid Grid.Row="2">
        <ListBox
            Margin="{controls:Inset Xs}"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Processes}"
            SelectedItem="{Binding SelectedProcess}"
            IsVisible="{Binding ShowContent}"
            AutomationProperties.Name="Process list">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- The File Viewer's row height: every list in the shell stands
                   at the same 30. -->
              <DockPanel
                  MinHeight="30"
                  Margin="{controls:Inset Horizontal=Sm}"
                  LastChildFill="True"
                  AutomationProperties.Name="{Binding AccessibleSummary}">
                <TextBlock DockPanel.Dock="Left" Width="70" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ProcessId}" />
                <TextBlock DockPanel.Dock="Right" Width="137" Margin="{controls:Inset Left=Sm}" VerticalAlignment="Center" Classes="Muted StartedCell" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Started}" />
                <TextBlock DockPanel.Dock="Right" Width="102" Margin="{controls:Inset Left=Sm}" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Memory}" />
                <TextBlock DockPanel.Dock="Right" Width="82" Margin="{controls:Inset Left=Sm}" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Cpu}" />
                <TextBlock
                    Margin="{controls:Inset Left=Sm}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ShellFontSize10}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Name}" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <controls:StateOverlay
            Kind="Loading"
            Heading="Waiting for first sample…"
            Body="Command lines, users, environments, and open files are not shown."
            IsVisible="{Binding ShowLoading}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Process monitor loading" />

        <controls:StateOverlay
            Kind="TerminalError"
            Glyph="ErrorCircle"
            Heading="{Binding IssueTitle}"
            Body="{Binding IssueMessage}"
            ActionLabel="Retry"
            ActionCommand="{Binding RefreshCommand}"
            IsVisible="{Binding ShowTerminalError}"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="Process monitor unavailable" />

        <controls:Callout
            Margin="{controls:Inset Md}"
            VerticalAlignment="Bottom"
            Glyph="Warning"
            Title="{Binding IssueTitle}"
            Text="{Binding IssueMessage}"
            IsVisible="{Binding ShowInlineIssue}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Process refresh status">
          <controls:Callout.Action>
            <Button Classes="SecondaryButton" Command="{Binding RefreshCommand}" Content="Retry" AutomationProperties.Name="Retry process list" />
          </controls:Callout.Action>
        </controls:Callout>
      </Grid>

    </Grid>
  </controls:PanelChrome>
</UserControl>
