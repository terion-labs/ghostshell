<UserControl
    x:Class="GhostShell.App.Views.RecoveryDataControlView"
    x:DataType="vm:RecoveryDataControlViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GhostShell.App.ViewModels"
    xmlns:controls="using:GhostShell.App.Controls">
  <controls:SurfaceCard>
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock FontWeight="SemiBold" Text="Crash recovery data" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="Review recovery snapshots from previous runs."
              TextWrapping="Wrap" />
        </StackPanel>
        <Button
            x:Name="RefreshRecoveryDataButton"
            Grid.Column="1"
            Classes="SecondaryButton"
            Click="OnRefreshClick"
            Content="Refresh"
            IsEnabled="{Binding CanRefresh}"
            AutomationProperties.Name="Refresh crash recovery data" />
        <Button
            Grid.Column="2"
            Classes="DestructiveButton"
            Click="OnClearAllClick"
            Content="Clear all previous"
            IsEnabled="{Binding CanClearAll}"
            AutomationProperties.Name="Clear all previous crash recovery data" />
      </Grid>

      <controls:Callout
          Tone="Notice"
          Glyph="Shield"
          Text="Only snapshots from previous runs are shown here. The current run is protected." />

      <controls:LiveRegionTextBlock
          Classes="Muted"
          FontSize="{DynamicResource ShellFontSize9}"
          Text="{Binding StatusMessage}"
          TextWrapping="Wrap"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding StatusAutomationName}" />

      <controls:StateOverlay
          Kind="Loading"
          Heading="Loading recovery metadata…"
          Body="The current run remains protected while previous snapshots are read."
          IsVisible="{Binding IsBusy}" />

      <controls:StateOverlay
          Kind="Empty"
          Heading="No previous recovery data"
          Body="The protected snapshot for the current run is intentionally not shown."
          IsVisible="{Binding HasNoRuns}" />

      <controls:StateOverlay
          Kind="Retry"
          Heading="Recovery metadata unavailable"
          Body="The current recovery inventory could not be loaded. No data will be removed automatically."
          ActionLabel="Refresh"
          ActionRequested="OnRefreshClick"
          FocusTarget="PrimaryAction"
          IsVisible="{Binding HasError}" />

      <ItemsControl
          ItemsSource="{Binding Runs}"
          IsEnabled="{Binding CanClearRuns}"
          IsVisible="{Binding HasRuns}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}" Margin="{controls:Inset Bottom=Sm}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Margin="{controls:Inset Right=Md}" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SnapshotLabel}" />
                    <TextBlock Margin="{controls:Inset Right=Md}" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SizeLabel}" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding UpdatedLabel}" />
                  </WrapPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="DestructiveButton"
                    Click="OnClearRunClick"
                    Content="Clear"
                    AutomationProperties.Name="{Binding ClearAutomationName}" />
              </Grid>
            </controls:SurfaceCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
