  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Tmds.DBus.SourceGenerator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellWindowsBuild)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="DBusXml/org.freedesktop.portal.Notification.xml" DBusGeneratorMode="Proxy" />
    <AdditionalFiles Include="DBusXml/org.freedesktop.portal.Settings.xml" DBusGeneratorMode="Proxy" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../LICENSE" Link="GHOSTSHELL-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/macos-release-legal.json" Link="MACOS-RELEASE-LEGAL.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/SMBLIBRARY-SOURCE.json" Link="SMBLIBRARY-SOURCE.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/SMBLIBRARY-SOURCE-AND-RELINKING.md" Link="SMBLIBRARY-SOURCE-AND-RELINKING.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/SMBLIBRARY-LGPL-3.0.txt" Link="SMBLIBRARY-LGPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/GPL-3.0.txt" Link="GPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../native/artifacts/common/fonts/JetBrainsMono/OFL.txt" Link="JETBRAINS-MONO-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GhostShellWindowsBuild Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">true</GhostShellWindowsBuild>
    <GhostShellWindowsBuild Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == 'win-x64'">true</GhostShellWindowsBuild>
    <GhostShellWindowsBuild Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</GhostShellWindowsBuild>
    <NuGetLockFilePath Condition="'$(GhostShellWindowsBuild)' == 'true' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">packages.windows.lock.json</NuGetLockFilePath>
    <TargetFramework Condition="'$(GhostShellWindowsBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(GhostShellWindowsBuild)' != 'true'">net10.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(GhostShellWindowsBuild)' == 'true'">10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting Condition="'$(GhostShellWindowsBuild)' == 'true'">true</EnableWindowsTargeting>
    <WindowsPackageType Condition="'$(GhostShellWindowsBuild)' == 'true'">None</WindowsPackageType>
    <!-- GhostSHELL uses Avalonia resources, not WinUI/MRT resources. The App SDK
         metapackage imports PRI tooling by default even for unpackaged apps. -->
    <EnablePriGenTooling Condition="'$(GhostShellWindowsBuild)' == 'true'">false</EnablePriGenTooling>
    <AppxGeneratePriEnabled Condition="'$(GhostShellWindowsBuild)' == 'true'">false</AppxGeneratePriEnabled>
    <AssemblyName>GhostShell</AssemblyName>
    <GhostShellEffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</GhostShellEffectiveRuntimeIdentifier>
    <GhostShellEffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</GhostShellEffectiveRuntimeIdentifier>
    <GhostShellRuntimePackVersion>10.0.11</GhostShellRuntimePackVersion>
    <GhostShellRuntimePackDirectory>$(NuGetPackageRoot)/microsoft.netcore.app.runtime.$(GhostShellEffectiveRuntimeIdentifier)/$(GhostShellRuntimePackVersion)</GhostShellRuntimePackDirectory>
    <GhostShellNativeTerminalLibrary Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-arm64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-x64'">libghostty-vt.dylib</GhostShellNativeTerminalLibrary>
    <GhostShellNativeTerminalLibrary Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'linux-arm64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'linux-x64'">libghostty-vt.so</GhostShellNativeTerminalLibrary>
    <GhostShellNativeTerminalLibrary Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'win-x64'">ghostty-vt.dll</GhostShellNativeTerminalLibrary>
    <GhostShellNativeTerminalRequired Condition="'$(GhostShellNativeTerminalLibrary)' != ''">true</GhostShellNativeTerminalRequired>
    <GhostShellNativeTerminalArtifactDirectory>$(MSBuildThisFileDirectory)../../native/artifacts/$(GhostShellEffectiveRuntimeIdentifier)</GhostShellNativeTerminalArtifactDirectory>
    <GhostShellNativeTerminalShellIntegrationDirectory>$(GhostShellNativeTerminalArtifactDirectory)/ghostty/shell-integration</GhostShellNativeTerminalShellIntegrationDirectory>
    <GhostShellSqlLanguageSupported Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'linux-x64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'linux-arm64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-x64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-arm64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'win-x64'">true</GhostShellSqlLanguageSupported>
    <GhostShellSqlLanguageRequired Condition="'$(GhostShellSqlLanguageRequired)' == ''">false</GhostShellSqlLanguageRequired>
    <GhostShellSqlLanguageWorkerName Condition="'$(GhostShellSqlLanguageSupported)' == 'true' and '$(GhostShellEffectiveRuntimeIdentifier)' == 'win-x64'">ghostshell-sql-language.exe</GhostShellSqlLanguageWorkerName>
    <GhostShellSqlLanguageWorkerName Condition="'$(GhostShellSqlLanguageSupported)' == 'true' and '$(GhostShellSqlLanguageWorkerName)' == ''">ghostshell-sql-language</GhostShellSqlLanguageWorkerName>
    <GhostShellSqlLanguageArtifactDirectory>$(MSBuildThisFileDirectory)../../native/artifacts/$(GhostShellEffectiveRuntimeIdentifier)</GhostShellSqlLanguageArtifactDirectory>
    <GhostShellSqlLanguageWorkerPath>$(GhostShellSqlLanguageArtifactDirectory)/$(GhostShellSqlLanguageWorkerName)</GhostShellSqlLanguageWorkerPath>
    <GhostShellSqlLanguagePayloadAvailable Condition="'$(GhostShellSqlLanguageSupported)' == 'true' and Exists('$(GhostShellSqlLanguageWorkerPath)') and Exists('$(GhostShellSqlLanguageArtifactDirectory)/THIRD-PARTY-NOTICES.md') and Exists('$(GhostShellSqlLanguageArtifactDirectory)/runtime-dependencies.txt') and Exists('$(GhostShellSqlLanguageArtifactDirectory)/build-receipt.json')">true</GhostShellSqlLanguagePayloadAvailable>
    <GhostShellWorkspaceGatewaySupported Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-arm64'">true</GhostShellWorkspaceGatewaySupported>
    <GhostShellWorkspaceGatewayRequired Condition="'$(GhostShellWorkspaceGatewayRequired)' == ''">false</GhostShellWorkspaceGatewayRequired>
    <GhostShellWorkspaceGatewayHostDirectory>$(MSBuildThisFileDirectory)../../native/artifacts/osx-arm64</GhostShellWorkspaceGatewayHostDirectory>
    <GhostShellWorkspaceGatewayHostName>ghostshell-workspace-gateway-darwin-arm64</GhostShellWorkspaceGatewayHostName>
    <GhostShellWorkspaceGatewayPayloadAvailable Condition="'$(GhostShellWorkspaceGatewaySupported)' == 'true' and Exists('$(GhostShellWorkspaceGatewayHostDirectory)/$(GhostShellWorkspaceGatewayHostName)') and Exists('$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-MANIFEST.sha256') and Exists('$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-THIRD-PARTY-NOTICES.md') and Exists('$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-GO-LICENSE.txt')">true</GhostShellWorkspaceGatewayPayloadAvailable>
    <GhostShellConnectionEnginesSupported Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-arm64'">true</GhostShellConnectionEnginesSupported>
    <GhostShellConnectionEnginesRequired Condition="'$(GhostShellConnectionEnginesRequired)' == ''">false</GhostShellConnectionEnginesRequired>
    <GhostShellConnectionEnginesDirectory>$(MSBuildThisFileDirectory)../../native/artifacts/osx-arm64/connection-engines</GhostShellConnectionEnginesDirectory>
    <GhostShellWorkspaceRuntimeDirectory>$(MSBuildThisFileDirectory)../../native/artifacts/osx-arm64/workspace-runtime</GhostShellWorkspaceRuntimeDirectory>
    <GhostShellWorkspaceBackendDirectory>$(MSBuildThisFileDirectory)../../native/artifacts/workspace-backend-build/distribution</GhostShellWorkspaceBackendDirectory>
    <GhostShellWorkspaceRuntimeRequired Condition="'$(GhostShellWorkspaceRuntimeRequired)' == ''">false</GhostShellWorkspaceRuntimeRequired>
    <GhostShellWorkspaceRuntimePayloadAvailable Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-arm64' and Exists('$(GhostShellWorkspaceRuntimeDirectory)/workspace-runtime') and Exists('$(GhostShellWorkspaceRuntimeDirectory)/kernel.bin') and Exists('$(GhostShellWorkspaceRuntimeDirectory)/initfs.ext4') and Exists('$(GhostShellWorkspaceRuntimeDirectory)/legal/MANIFEST.sha256')">true</GhostShellWorkspaceRuntimePayloadAvailable>
    <GhostShellConnectionEnginesPayloadAvailable Condition="'$(GhostShellConnectionEnginesSupported)' == 'true' and Exists('$(GhostShellConnectionEnginesDirectory)/ghostshell-openvpn-engine') and Exists('$(GhostShellConnectionEnginesDirectory)/openconnect') and Exists('$(GhostShellConnectionEnginesDirectory)/libopenconnect.5.dylib') and Exists('$(GhostShellConnectionEnginesDirectory)/tailscale') and Exists('$(GhostShellConnectionEnginesDirectory)/tailscaled') and Exists('$(GhostShellConnectionEnginesDirectory)/MANIFEST.sha256') and Exists('$(GhostShellConnectionEnginesDirectory)/THIRD-PARTY-NOTICES.md') and Exists('$(GhostShellConnectionEnginesDirectory)/OPENCONNECT-SOURCE-AND-RELINKING.md') and Exists('$(GhostShellConnectionEnginesDirectory)/OPENVPN-VERSIONS.txt') and Exists('$(GhostShellConnectionEnginesDirectory)/sources/openconnect-9.21.tar.gz')">true</GhostShellConnectionEnginesPayloadAvailable>
    <GhostShellCefRuntimeArtifactDirectory Condition="'$(GhostShellCefRuntimeArtifactDirectory)' == ''">$(GhostShellNativeTerminalArtifactDirectory)/cef</GhostShellCefRuntimeArtifactDirectory>
    <GhostShellCefMacRuntime Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-arm64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-x64'">true</GhostShellCefMacRuntime>
    <GhostShellCefFlatRuntime Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'linux-arm64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'linux-x64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'win-x64'">true</GhostShellCefFlatRuntime>
    <GhostShellCefRuntimeRequired Condition="'$(GhostShellCefMacRuntime)' == 'true' or '$(GhostShellCefFlatRuntime)' == 'true'">true</GhostShellCefRuntimeRequired>
    <GhostShellCefShimLibrary Condition="'$(GhostShellCefMacRuntime)' == 'true'">libexclr8cef.dylib</GhostShellCefShimLibrary>
    <GhostShellCefShimLibrary Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'linux-arm64' or '$(GhostShellEffectiveRuntimeIdentifier)' == 'linux-x64'">libexclr8cef.so</GhostShellCefShimLibrary>
    <GhostShellCefShimLibrary Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'win-x64'">exclr8cef.dll</GhostShellCefShimLibrary>
  </PropertyGroup>

  <!-- Keep Native AOT scoped to the packaged macOS application. Passing
       PublishAot as a global command-line property would incorrectly add the
       AOT toolchain to every ProjectReference lock file. -->
  <PropertyGroup Condition="'$(GhostShellMacReleaseNativeAot)' == 'true'">
    <NuGetLockFilePath>packages.osx-arm64.aot.lock.json</NuGetLockFilePath>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Reflection-based JSON is disabled at runtime. First-party projects set
         IsAotCompatible globally, so unsupported reflection and dynamic-code
         paths fail in the assembly that owns them. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
    <!-- Dependency warnings remain visible here and are audited separately;
         first-party IL2026/IL3050 diagnostics are already build errors. -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <LinkerFlavor Condition="'$(GhostShellNativeAotLinker)' != ''">$(GhostShellNativeAotLinker)</LinkerFlavor>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(GhostShellRuntimePackDirectory)/LICENSE.TXT') and Exists('$(GhostShellRuntimePackDirectory)/THIRD-PARTY-NOTICES.TXT')">
    <Content Include="$(GhostShellRuntimePackDirectory)/LICENSE.TXT" Link="DOTNET-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellRuntimePackDirectory)/THIRD-PARTY-NOTICES.TXT" Link="DOTNET-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Calcite payload is optional for developer builds and required by release
       packaging. Preserve the RID layout expected by CalciteSqlLanguageService. -->
  <ItemGroup Condition="'$(GhostShellSqlLanguagePayloadAvailable)' == 'true'">
    <Content Include="$(GhostShellSqlLanguageWorkerPath)" Link="runtimes/$(GhostShellEffectiveRuntimeIdentifier)/native/$(GhostShellSqlLanguageWorkerName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellSqlLanguageArtifactDirectory)/THIRD-PARTY-NOTICES.md" Link="runtimes/$(GhostShellEffectiveRuntimeIdentifier)/native/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellSqlLanguageArtifactDirectory)/runtime-dependencies.txt" Link="runtimes/$(GhostShellEffectiveRuntimeIdentifier)/native/runtime-dependencies.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellSqlLanguageArtifactDirectory)/build-receipt.json" Link="runtimes/$(GhostShellEffectiveRuntimeIdentifier)/native/build-receipt.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellSqlLanguageRequired)' == 'true' and '$(GhostShellSqlLanguageSupported)' == 'true'">
    <GhostShellSqlLanguageRequiredFile Include="$(GhostShellSqlLanguageWorkerPath)" />
    <GhostShellSqlLanguageRequiredFile Include="$(GhostShellSqlLanguageArtifactDirectory)/THIRD-PARTY-NOTICES.md" />
    <GhostShellSqlLanguageRequiredFile Include="$(GhostShellSqlLanguageArtifactDirectory)/runtime-dependencies.txt" />
    <GhostShellSqlLanguageRequiredFile Include="$(GhostShellSqlLanguageArtifactDirectory)/build-receipt.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellWorkspaceGatewayPayloadAvailable)' == 'true'">
    <Content Include="$(GhostShellWorkspaceGatewayHostDirectory)/$(GhostShellWorkspaceGatewayHostName)" Link="runtimes/osx-arm64/native/$(GhostShellWorkspaceGatewayHostName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-MANIFEST.sha256" Link="runtimes/osx-arm64/native/workspace-network-gateway-MANIFEST.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-THIRD-PARTY-NOTICES.md" Link="runtimes/osx-arm64/native/workspace-network-gateway-THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-GO-LICENSE.txt" Link="runtimes/osx-arm64/native/workspace-network-gateway-GO-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellWorkspaceGatewayRequired)' == 'true' and '$(GhostShellWorkspaceGatewaySupported)' == 'true'">
    <GhostShellWorkspaceGatewayRequiredFile Include="$(GhostShellWorkspaceGatewayHostDirectory)/$(GhostShellWorkspaceGatewayHostName)" />
    <GhostShellWorkspaceGatewayRequiredFile Include="$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-MANIFEST.sha256" />
    <GhostShellWorkspaceGatewayRequiredFile Include="$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-THIRD-PARTY-NOTICES.md" />
    <GhostShellWorkspaceGatewayRequiredFile Include="$(GhostShellWorkspaceGatewayHostDirectory)/workspace-network-gateway-GO-LICENSE.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellConnectionEnginesPayloadAvailable)' == 'true'">
    <Content Include="$(GhostShellConnectionEnginesDirectory)/ghostshell-openvpn-engine;$(GhostShellConnectionEnginesDirectory)/openconnect;$(GhostShellConnectionEnginesDirectory)/libopenconnect.5.dylib;$(GhostShellConnectionEnginesDirectory)/tailscale;$(GhostShellConnectionEnginesDirectory)/tailscaled" Link="runtimes/osx-arm64/connection-engines/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellConnectionEnginesDirectory)/*.txt;$(GhostShellConnectionEnginesDirectory)/*.md;$(GhostShellConnectionEnginesDirectory)/*.sha256" Link="connection-engine-legal/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellWorkspaceRuntimePayloadAvailable)' == 'true'">
    <Content Include="$(GhostShellWorkspaceRuntimeDirectory)/**/*" Exclude="$(GhostShellWorkspaceRuntimeDirectory)/legal/**/*;$(GhostShellWorkspaceRuntimeDirectory)/kernel.bin;$(GhostShellWorkspaceRuntimeDirectory)/initfs.ext4" Link="runtimes/osx-arm64/workspace-runtime/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellWorkspaceRuntimeDirectory)/legal/**/*" Exclude="$(GhostShellWorkspaceRuntimeDirectory)/legal/sources/**/*" Link="workspace-runtime-legal/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellWorkspaceRuntimeRequired)' == 'true'">
    <GhostShellWorkspaceRuntimeRequiredFile Include="$(GhostShellWorkspaceRuntimeDirectory)/boot-assets.json" />
    <GhostShellWorkspaceRuntimeRequiredFile Include="$(GhostShellWorkspaceRuntimeDirectory)/legal/SOURCE-MANIFEST.sha256;$(GhostShellWorkspaceRuntimeDirectory)/legal/SWIFT-LICENSE.txt;$(GhostShellWorkspaceRuntimeDirectory)/legal/MUSL-COPYRIGHT.txt;$(GhostShellWorkspaceRuntimeDirectory)/legal/WorkspaceRuntime.entitlements" />
    <GhostShellWorkspaceRuntimeRequiredFile Include="$(GhostShellWorkspaceRuntimeDirectory)/workspace-runtime;$(GhostShellWorkspaceRuntimeDirectory)/kernel.bin;$(GhostShellWorkspaceRuntimeDirectory)/initfs.ext4;$(GhostShellWorkspaceRuntimeDirectory)/legal/MANIFEST.sha256;$(GhostShellWorkspaceRuntimeDirectory)/legal/Package.resolved;$(GhostShellWorkspaceRuntimeDirectory)/legal/THIRD-PARTY-NOTICES.md;$(GhostShellWorkspaceRuntimeDirectory)/legal/SOURCE-AND-BUILD.md;$(GhostShellWorkspaceRuntimeDirectory)/legal/kernel.config;$(GhostShellWorkspaceRuntimeDirectory)/legal/LINUX-GPL-2.0.txt;$(GhostShellWorkspaceRuntimeDirectory)/legal/sources/linux-6.18.35.tar.xz;$(GhostShellWorkspaceRuntimeDirectory)/legal/sources/kata-containers-3.32.0.tar.gz" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellConnectionEnginesRequired)' == 'true' and '$(GhostShellConnectionEnginesSupported)' == 'true'">
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/ghostshell-openvpn-engine" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/openconnect" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/libopenconnect.5.dylib" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/tailscale" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/tailscaled" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/MANIFEST.sha256" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/THIRD-PARTY-NOTICES.md" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/GO-LICENSE.txt" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/OPENCONNECT-LGPL-2.1.txt" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/OPENCONNECT-SOURCE-AND-RELINKING.md" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/OPENSSL-LICENSE.txt" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/OPENVPN-MPL-2.0.txt" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/OPENVPN-LICENSE.md" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/ASIO-LICENSE.txt" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/LZ4-LICENSE.txt" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/OPENVPN-VERSIONS.txt" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/OPENVPN-THIRD-PARTY-NOTICES.txt" />
    <GhostShellConnectionEnginesRequiredFile Include="$(GhostShellConnectionEnginesDirectory)/sources/openconnect-9.21.tar.gz" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellNativeTerminalRequired)' == 'true'">
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalArtifactDirectory)/$(GhostShellNativeTerminalLibrary)" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalArtifactDirectory)/libghostshell_pty.dylib" Condition="$(GhostShellEffectiveRuntimeIdentifier.StartsWith('osx-'))" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalArtifactDirectory)/libghostshell_pty.so" Condition="$(GhostShellEffectiveRuntimeIdentifier.StartsWith('linux-'))" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalArtifactDirectory)/PORTA-PTY-LICENSE" Condition="!$(GhostShellEffectiveRuntimeIdentifier.StartsWith('win-'))" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalArtifactDirectory)/GHOSTTY-LICENSE" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalArtifactDirectory)/ghostty-vt-required-exports.txt" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalArtifactDirectory)/native-terminal-build-receipt.json" />
    <GhostShellNativeTerminalRequiredFile Include="$(MSBuildThisFileDirectory)../../licenses/native-terminal-components.json" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/MANIFEST.sha256" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/SHELL-INTEGRATION-NOTICE.md" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/bash/bash-preexec.sh" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/bash/ghostty.bash" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/fish/vendor_conf.d/ghostty-shell-integration.fish" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/zsh/.zshenv" />
    <GhostShellNativeTerminalRequiredFile Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/zsh/ghostty-integration" />

    <Content Include="$(GhostShellNativeTerminalArtifactDirectory)/$(GhostShellNativeTerminalLibrary)" Link="$(GhostShellNativeTerminalLibrary)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalArtifactDirectory)/PORTA-PTY-LICENSE" Link="PORTA-PTY-LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="!$(GhostShellEffectiveRuntimeIdentifier.StartsWith('win-'))" />
    <Content Include="$(GhostShellNativeTerminalArtifactDirectory)/GHOSTTY-LICENSE" Link="GHOSTTY-LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalArtifactDirectory)/ghostty-vt-required-exports.txt" Link="ghostty-vt-required-exports.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalArtifactDirectory)/native-terminal-build-receipt.json" Link="native-terminal-build-receipt.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/native-terminal-components.json" Link="native-terminal-components.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/MANIFEST.sha256" Link="ghostty/shell-integration/MANIFEST.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/SHELL-INTEGRATION-NOTICE.md" Link="ghostty/shell-integration/SHELL-INTEGRATION-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/bash/bash-preexec.sh" Link="ghostty/shell-integration/bash/bash-preexec.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/bash/ghostty.bash" Link="ghostty/shell-integration/bash/ghostty.bash" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/fish/vendor_conf.d/ghostty-shell-integration.fish" Link="ghostty/shell-integration/fish/vendor_conf.d/ghostty-shell-integration.fish" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/zsh/.zshenv" Link="ghostty/shell-integration/zsh/.zshenv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GhostShellNativeTerminalShellIntegrationDirectory)/zsh/ghostty-integration" Link="ghostty/shell-integration/zsh/ghostty-integration" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellCefRuntimeRequired)' == 'true'">
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/$(GhostShellCefShimLibrary)" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/CEF-LICENSE.txt" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/CEF-CREDITS.html" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/EXCLR8CEF-LICENSE.txt" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/cef-runtime-build-receipt.json" />
    <GhostShellCefRequiredFile Include="$(MSBuildThisFileDirectory)../../licenses/cef-runtime-components.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellCefMacRuntime)' == 'true'">
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/Chromium Embedded Framework.framework/Chromium Embedded Framework" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/GhostSHELL Helper.app/Contents/MacOS/GhostSHELL Helper" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/GhostSHELL Helper (Alerts).app/Contents/MacOS/GhostSHELL Helper (Alerts)" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/GhostSHELL Helper (GPU).app/Contents/MacOS/GhostSHELL Helper (GPU)" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/GhostSHELL Helper (Plugin).app/Contents/MacOS/GhostSHELL Helper (Plugin)" />
    <GhostShellCefRequiredFile Include="$(GhostShellCefRuntimeArtifactDirectory)/GhostSHELL Helper (Renderer).app/Contents/MacOS/GhostSHELL Helper (Renderer)" />

    <!-- The unbundled macOS build can resolve the shim for compile/test probes,
         but CEF itself is runnable only after the app-bundle packager installs
         its framework and helpers under Contents/Frameworks. -->
    <Content Include="$(GhostShellCefRuntimeArtifactDirectory)/$(GhostShellCefShimLibrary)" Link="$(GhostShellCefShimLibrary)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('$(GhostShellCefRuntimeArtifactDirectory)/$(GhostShellCefShimLibrary)')" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellCefFlatRuntime)' == 'true'">
    <Content Include="$(GhostShellCefRuntimeArtifactDirectory)/**/*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/cef-runtime-components.json" Link="cef-runtime-components.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target
      Name="ValidateNativeTerminalPayload"
      BeforeTargets="PrepareForBuild;Publish"
      Condition="'$(GhostShellNativeTerminalRequired)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error
        Condition="!Exists('%(GhostShellNativeTerminalRequiredFile.Identity)')"
        Text="The required libghostty-vt payload for $(GhostShellEffectiveRuntimeIdentifier) is incomplete; missing %(GhostShellNativeTerminalRequiredFile.Identity). Run ./scripts/build-libghostty-vt.sh --rid $(GhostShellEffectiveRuntimeIdentifier)." />
  </Target>

  <Target
      Name="ValidateSqlLanguagePayload"
      BeforeTargets="PrepareForBuild;Publish"
      Condition="'$(GhostShellSqlLanguageRequired)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error
        Condition="'$(GhostShellSqlLanguageSupported)' != 'true'"
        Text="The SQL language worker is not supported for $(GhostShellEffectiveRuntimeIdentifier). Supported release RIDs are linux-x64, linux-arm64, osx-x64, osx-arm64, and win-x64; win-arm64 is unsupported by GraalVM Native Image." />
    <Error
        Condition="'$(GhostShellSqlLanguageSupported)' == 'true' and !Exists('%(GhostShellSqlLanguageRequiredFile.Identity)')"
        Text="The required SQL language payload for $(GhostShellEffectiveRuntimeIdentifier) is incomplete; missing %(GhostShellSqlLanguageRequiredFile.Identity). Run ./scripts/build-sql-language-worker.sh --rid $(GhostShellEffectiveRuntimeIdentifier)." />
  </Target>

  <Target
      Name="ValidateWorkspaceGatewayPayload"
      BeforeTargets="PrepareForBuild;Publish"
      Condition="'$(GhostShellWorkspaceGatewayRequired)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error
        Condition="'$(GhostShellWorkspaceGatewaySupported)' != 'true'"
        Text="The workspace network gateway is supported only by the osx-arm64 application." />
    <Error
        Condition="'$(GhostShellWorkspaceGatewaySupported)' == 'true' and !Exists('%(GhostShellWorkspaceGatewayRequiredFile.Identity)')"
        Text="The required workspace network gateway payload is incomplete; missing %(GhostShellWorkspaceGatewayRequiredFile.Identity). Run ./scripts/build-workspace-network-gateway.sh --rid osx-arm64." />
  </Target>

  <Target
      Name="ValidateConnectionEnginesPayload"
      BeforeTargets="PrepareForBuild;Publish"
      Condition="'$(GhostShellConnectionEnginesRequired)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error
        Condition="'$(GhostShellConnectionEnginesSupported)' != 'true'"
        Text="The bundled connection engine payload is supported only by the osx-arm64 application." />
    <Error
        Condition="'$(GhostShellConnectionEnginesSupported)' == 'true' and !Exists('%(GhostShellConnectionEnginesRequiredFile.Identity)')"
        Text="The bundled connection engine payload is incomplete; missing %(GhostShellConnectionEnginesRequiredFile.Identity). Run ./scripts/build-macos-connection-engines.sh." />
  </Target>

  <ItemGroup Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'osx-arm64' and Exists('$(GhostShellWorkspaceBackendDirectory)/backend-assets.json')">
    <!-- Only the signed pin ships in the app; Linux code is provisioned on demand. -->
    <Content Include="$(GhostShellWorkspaceBackendDirectory)/backend-assets.json" Link="runtimes/linux-arm64/workspace-backend/backend-assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateWorkspaceRuntimePayload" BeforeTargets="PrepareForBuild;Publish" Condition="'$(GhostShellWorkspaceRuntimeRequired)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(GhostShellWorkspaceBackendDirectory)/backend-assets.json')" Text="The on-demand workspace backend descriptor is missing. Run ./scripts/build-workspace-backend.sh." />
    <Error Condition="'$(GhostShellEffectiveRuntimeIdentifier)' != 'osx-arm64'" Text="The SDK workspace runtime is supported only by the osx-arm64 application." />
    <Error Condition="!Exists('%(GhostShellWorkspaceRuntimeRequiredFile.Identity)')" Text="The bundled workspace runtime is incomplete; missing %(GhostShellWorkspaceRuntimeRequiredFile.Identity). Run ./scripts/build-workspace-runtime.sh." />
  </Target>

  <Target
      Name="ValidateCefRuntimePayload"
      BeforeTargets="Publish"
      Condition="'$(GhostShellCefRuntimeRequired)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error
        Condition="!Exists('%(GhostShellCefRequiredFile.Identity)')"
        Text="The required CEF runtime payload for $(GhostShellEffectiveRuntimeIdentifier) is incomplete; missing %(GhostShellCefRequiredFile.Identity). Run ./scripts/build-cef-runtime.sh --rid $(GhostShellEffectiveRuntimeIdentifier)." />
  </Target>

  <Target
      Name="ValidateServicedRuntimePack"
      AfterTargets="ProcessFrameworkReferences"
      Condition="'$(SelfContained)' == 'true' and '$(GhostShellSqlLanguageSupported)' == 'true'">
    <ItemGroup>
      <GhostShellSelectedRuntimePack
          Include="@(RuntimePack)"
          Condition="'%(RuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error
        Condition="'@(GhostShellSelectedRuntimePack)' == ''"
        Text="The self-contained package did not resolve a Microsoft.NETCore.App runtime pack for $(GhostShellEffectiveRuntimeIdentifier)." />
    <Error
        Condition="'%(GhostShellSelectedRuntimePack.NuGetPackageVersion)' != '$(GhostShellRuntimePackVersion)'"
        Text="The self-contained package selected Microsoft.NETCore.App runtime %(GhostShellSelectedRuntimePack.NuGetPackageVersion) for $(GhostShellEffectiveRuntimeIdentifier), but release evidence is pinned to $(GhostShellRuntimePackVersion)." />
  </Target>

  <Target
      Name="BlockUnsandboxedWindowsCefPublish"
      BeforeTargets="Publish"
      Condition="'$(GhostShellEffectiveRuntimeIdentifier)' == 'win-x64' and '$(GhostShellAllowUnsandboxedWindowsCefDevelopment)' != 'true'">
    <Error Text="CEF 150 Windows publishing is blocked until GhostSHELL owns a native bootstrap/CLR launcher. Set GhostShellAllowUnsandboxedWindowsCefDevelopment=true only for an explicit non-release development publish." />
  </Target>

  <!--
    .NET 10's apphost currently advertises SDK 15.5, which makes macOS 26 retain
    compatibility chrome. Keep ordinary `dotnet run` builds on the same native
    title-bar path as packaged builds until the runtime ships an SDK-26 apphost.
  -->
  <Target
      Name="DeclareMacOs26Sdk"
      AfterTargets="Build"
      Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('$(TargetDir)$(AssemblyName)')">
    <Exec Command="&quot;$(GhostShellRepositoryRoot)scripts/declare-macos-sdk26.sh&quot; &quot;$(TargetDir)$(AssemblyName)&quot;" />
  </Target>

  <!-- CEF on macOS must run from an application bundle so its framework and
       five helper subprocess bundles resolve through Contents/Frameworks. -->
  <Target
      Name="ConfigureMacOsDevelopmentRun"
      BeforeTargets="ComputeRunArguments"
      Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(GhostShellCefMacRuntime)' == 'true'">
    <PropertyGroup>
      <GhostShellForwardedRunArguments>$(RunArguments)</GhostShellForwardedRunArguments>
      <GhostShellMacDevelopmentApp>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)macos-run/GhostShell.dev.app</GhostShellMacDevelopmentApp>
      <RunCommand>$(GhostShellRepositoryRoot)scripts/run-macos-development.sh</RunCommand>
      <RunArguments>--target-directory &quot;$(TargetDir)&quot; --cef-runtime-root &quot;$(GhostShellCefRuntimeArtifactDirectory)&quot; --app &quot;$(GhostShellMacDevelopmentApp)&quot; --info-plist-template &quot;$(GhostShellRepositoryRoot)tools/GhostShell.Packaging/MacOS/Info.plist.template&quot; -- $(GhostShellForwardedRunArguments)</RunArguments>
    </PropertyGroup>
  </Target>

</Project>
