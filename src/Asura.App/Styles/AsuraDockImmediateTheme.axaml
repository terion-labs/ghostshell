<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dock="using:Dock.Avalonia.Controls"
    xmlns:dockConverters="using:Dock.Avalonia.Converters"
    xmlns:dockCore="using:Dock.Model.Core"
    xmlns:dockModel="using:Dock.Model.Controls"
    xmlns:dockSettings="using:Dock.Settings"
    xmlns:components="using:Asura.App.Views.Components">
  <!--
    Dock 12 defers Layout, RootDock.ActiveDockable, and
    DocumentDock.ActiveDockable through a shared background queue. Those are
    presentation optimizations, not model requirements. Asura restores a
    complete active workspace before showing its window, and every one of those
    active boundaries must therefore materialize deterministically in the first
    frame. Keep Dock's themes and named parts, replacing only the three deferred
    hosts with ordinary ContentControls.
  -->
  <Styles.Resources>
    <ControlTheme
        x:Key="AsuraRootDockControlTheme"
        TargetType="dock:RootDockControl"
        BasedOn="{StaticResource {x:Type dock:RootDockControl}}">
      <Setter Property="Template">
        <ControlTemplate>
          <dock:DockableControl x:DataType="dockModel:IRootDock" TrackingMode="Visible">
            <DockPanel Background="Transparent" dockSettings:DockProperties.IsDropArea="False">
              <dock:ToolPinnedControl
                  DockPanel.Dock="Left"
                  Orientation="Vertical"
                  ItemsSource="{Binding LeftPinnedDockables}"
                  IsVisible="{Binding !!LeftPinnedDockables?.Count, TargetNullValue={x:False}, FallbackValue={x:False}}" />
              <dock:ToolPinnedControl
                  DockPanel.Dock="Right"
                  Orientation="Vertical"
                  ItemsSource="{Binding RightPinnedDockables}"
                  IsVisible="{Binding !!RightPinnedDockables?.Count, TargetNullValue={x:False}, FallbackValue={x:False}}" />
              <dock:ToolPinnedControl
                  DockPanel.Dock="Top"
                  Orientation="Horizontal"
                  ItemsSource="{Binding TopPinnedDockables}"
                  IsVisible="{Binding !!TopPinnedDockables?.Count, TargetNullValue={x:False}, FallbackValue={x:False}}" />
              <dock:ToolPinnedControl
                  DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  ItemsSource="{Binding BottomPinnedDockables}"
                  IsVisible="{Binding !!BottomPinnedDockables?.Count, TargetNullValue={x:False}, FallbackValue={x:False}}" />
              <dock:PinnedDockHostPanel
                  PinnedDockDisplayMode="{Binding PinnedDockDisplayMode}"
                  PinnedDockAlignment="{Binding PinnedDock?.Alignment, TargetNullValue={x:Static dockCore:Alignment.Unset}, FallbackValue={x:Static dockCore:Alignment.Unset}}">
                <ContentControl x:Name="PART_MainContent" Content="{Binding ActiveDockable}" />
                <dock:PinnedDockControl />
              </dock:PinnedDockHostPanel>
            </DockPanel>
          </dock:DockableControl>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme
        x:Key="AsuraDocumentControlTheme"
        TargetType="dock:DocumentControl"
        BasedOn="{StaticResource {x:Type dock:DocumentControl}}">
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel
              x:DataType="dockModel:IDocumentDock"
              x:Name="PART_DockPanel"
              Background="Transparent"
              VerticalSpacing="{DynamicResource DockDocumentControlVerticalSpacing}"
              ZIndex="1"
              dockSettings:DockProperties.IsDropArea="True"
              dockSettings:DockProperties.IsDockTarget="True"
              dockSettings:DockProperties.ShowDockIndicatorOnly="{DynamicResource DockDocumentControlShowDockIndicatorOnly}"
              dockSettings:DockProperties.IndicatorDockOperation="{DynamicResource DockDocumentControlIndicatorDockOperation}">
            <dock:DocumentTabStrip
                x:Name="PART_TabStrip"
                DockPanel.Dock="{Binding TabsLayout, Converter={x:Static dockConverters:DocumentTabDockConverter.Instance}}"
                ItemsSource="{Binding VisibleDockables}"
                SelectedItem="{Binding ActiveDockable, Mode=TwoWay}"
                CanCreateItem="{Binding CanCreateDocument}"
                IconTemplate="{TemplateBinding IconTemplate}"
                HeaderTemplate="{TemplateBinding HeaderTemplate}"
                ModifiedTemplate="{TemplateBinding ModifiedTemplate}"
                CloseTemplate="{TemplateBinding CloseTemplate}"
                CloseButtonTheme="{TemplateBinding CloseButtonTheme}"
                IsActive="{TemplateBinding IsActive}"
                Orientation="{Binding TabsLayout, Converter={x:Static dockConverters:DocumentTabOrientationConverter.Instance}}"
                dockSettings:DockProperties.IsDropArea="True"
                dockSettings:DockProperties.DockAdornerHost="{Binding #PART_DockPanel}">
              <dock:DocumentTabStrip.Styles>
                <Style Selector="dock|DocumentTabStripItem">
                  <Setter Property="IsActive" Value="{Binding $parent[dock:DocumentTabStrip].IsActive}" />
                </Style>
              </dock:DocumentTabStrip.Styles>
            </dock:DocumentTabStrip>
            <Panel x:Name="PART_DocumentSeperatorHost" IsVisible="{Binding #PART_TabStrip.IsVisible}">
              <Panel x:Name="PART_DocumentSeperator" IsVisible="{DynamicResource DockDocumentTabStripSeparatorVisible}" />
            </Panel>
            <Border x:Name="PART_Border">
              <Grid>
                <dock:DockableControl
                    TrackingMode="Visible"
                    IsVisible="{Binding $parent[dock:DocumentControl].HasVisibleDockables}">
                  <components:RuntimePanelContentControl
                      x:Name="PART_ContentPresenter"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
                </dock:DockableControl>
                <ContentControl
                    x:Name="PART_EmptyContentHost"
                    Content="{Binding EmptyContent}"
                    ContentTemplate="{Binding $parent[dock:DocumentControl].EmptyContentTemplate}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsVisible="{Binding !$parent[dock:DocumentControl].HasVisibleDockables}" />
              </Grid>
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="dock|RootDockControl">
    <Setter Property="Theme" Value="{StaticResource AsuraRootDockControlTheme}" />
  </Style>
  <Style Selector="dock|DocumentControl">
    <Setter Property="Theme" Value="{StaticResource AsuraDocumentControlTheme}" />
  </Style>
</Styles>
