<Window
    x:Class="Asura.App.Views.FileAccessControlDialog"
    x:DataType="vm:FileAccessControlEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:vm="using:Asura.App.ViewModels"
    Width="520"
    Height="400"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <controls:DialogShell
      Chrome="Utility"
      Title="{Binding ItemName}"
      Subtitle="{Binding Summary}"
      Scrolls="False">
    <!--
      One table for both models. A filesystem's three parties and an object
      store's accounts are the same question asked of different systems, so they
      are read the same way: a name, and what that name is allowed.
    -->
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,150,Auto" Margin="{controls:Inset Horizontal=Md, Bottom=Xs}">
        <TextBlock Classes="Eyebrow" Text="Name" />
        <TextBlock Grid.Column="1" Classes="Eyebrow" Text="Privilege" />
        <!-- Sized to the switch below it rather than to the word, so the two
             line up and the column takes no more room than the control needs.
             Hidden, it measures nothing and the column closes up entirely,
             which is what an object store's table wants. -->
        <TextBlock
            Grid.Column="2"
            Width="38"
            Classes="Eyebrow"
            Text="Run"
            TextAlignment="Center"
            IsVisible="{Binding HasMode}" />
      </Grid>

      <controls:SurfaceCard Grid.Row="1" Padding="{controls:Inset None}" VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:FileAccessRowViewModel">
              <Grid
                  Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                  ColumnDefinitions="*,150,Auto"
                  ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock
                      FontSize="{DynamicResource ShellFontSize10}"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis" />
                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellFontSize9}"
                      Text="{Binding Detail}"
                      IsVisible="{Binding HasDetail}"
                      TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Choices}"
                    SelectedItem="{Binding Privilege, Mode=TwoWay}"
                    IsEnabled="{Binding $parent[Window].((vm:FileAccessControlEditorViewModel)DataContext).CanEdit}"
                    AutomationProperties.Name="{Binding PrivilegeLabel}" />
                <ToggleSwitch
                    Grid.Column="2"
                    Width="38"
                    HorizontalAlignment="Center"
                    IsChecked="{Binding CanRun, Mode=TwoWay}"
                    IsVisible="{Binding ShowsExecute}"
                    IsEnabled="{Binding $parent[Window].((vm:FileAccessControlEditorViewModel)DataContext).CanEdit}"
                    AutomationProperties.Name="{Binding Name, StringFormat={}{0} can run this}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:SurfaceCard>

      <StackPanel Grid.Row="2" Margin="{controls:Inset Top=Md}" Spacing="{DynamicResource ShellSpaceXs}">
        <!-- The number, because it is what anybody working at a shell reads,
             and because the privileges above cannot express every mode. -->
        <controls:LiveRegionTextBlock
            Classes="Muted"
            FontFamily="{DynamicResource ShellDataFontFamily}"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="{Binding ModeText}"
            IsVisible="{Binding HasMode}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Permission bits" />
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="{Binding ReadOnlyReason}"
            IsVisible="{Binding !CanEdit}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Close" />
        <Button
            Classes="PrimaryButton"
            Click="OnApplyClick"
            Content="Apply"
            IsEnabled="{Binding CanEdit}"
            AutomationProperties.Name="Apply permission changes" />
      </StackPanel>
    </controls:DialogShell.Footer>
  </controls:DialogShell>
</Window>
