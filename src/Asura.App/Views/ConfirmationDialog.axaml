<Window
    x:Class="Asura.App.Views.ConfirmationDialog"
    x:DataType="views:ConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Asura.App.Views"
    xmlns:controls="using:Asura.App.Controls"
    Title="Confirm"
    Width="480"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <!--
    The shell's one confirmation window.

    There used to be ten of these — delete, clear, reset, discard, close,
    error — each its own Window with the same three rows re-typed: heading and
    detail, an optional card stating the blast radius, and a Cancel/act pair.
    They differed only in strings, in three arbitrary widths, and in a heading
    size that had drifted a point. What a confirmation asks is configuration;
    what one looks like is decided here, once.
  -->
  <Grid Margin="{controls:Inset Xl}" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceLg}">
    <controls:StateOverlay
        x:Name="ConfirmationState"
        HorizontalAlignment="Stretch"
        Heading="{Binding Heading}"
        Body="{Binding Detail}" />
    <controls:SurfaceCard
        x:Name="NoticeCard"
        Grid.Row="1"
        Tone="Notice"
        Padding="{DynamicResource ShellCardPaddingCompact}"
        IsVisible="{Binding HasNotice}">
      <TextBlock Classes="Muted" Text="{Binding Notice}" TextWrapping="Wrap" />
    </controls:SurfaceCard>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button
          x:Name="CancelButton"
          MinWidth="88"
          Click="OnCancelClick"
          Content="{Binding CancelLabel}"
          IsCancel="True"
          IsVisible="{Binding ShowsCancel}" />
      <Button
          x:Name="ConfirmButton"
          MinWidth="112"
          Click="OnConfirmClick"
          Content="{Binding ConfirmLabel}" />
    </StackPanel>
  </Grid>
</Window>
