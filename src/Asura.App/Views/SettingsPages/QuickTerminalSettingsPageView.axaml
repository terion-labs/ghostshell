<UserControl
    x:Class="Asura.App.Views.SettingsPages.QuickTerminalSettingsPageView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <!--
    Every group here used to be a hand-built card: a two-column grid with its own
    column width, its own insets, a semibold label, a muted description restating
    its own font size, and a one-pixel Border written between each pair of rows.
    Four groups meant four column widths (300, 280, 280, and auto), ten hand-placed
    separators, and a description style repeated fourteen times. None of it could be
    reached by the density or corner-radius settings.

    The page now says only what each setting is. Where the label sits, how wide the
    control column is, and which row draws a separator are the group's business.
  -->
  <StackPanel Spacing="{DynamicResource ShellSpaceXl}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
      <components:SettingsPageHeader
          Heading="Quick Terminal"
          Description="A global drop-down terminal that stays one keystroke away. Configure where it appears and how it behaves." />
      <Button
          Grid.Column="1"
          VerticalAlignment="Bottom"
          Classes="PrimaryButton"
          Click="OnSaveQuickTerminalSettingsClick"
          Content="Save settings"
          AutomationProperties.Name="Save Quick Terminal settings" />
    </Grid>

    <controls:SettingsGroup
        Heading="Activation"
        Description="Choose the global shortcut used to summon or dismiss the panel."
        ControlWidth="300">
      <controls:SettingRow
          Label="Global hotkey"
          Description="{Binding QuickTerminalSettingsEditor.HotkeyHelpText}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <TextBox
              Text="{Binding QuickTerminalSettingsEditor.HotkeyText}"
              AutomationProperties.Name="Quick Terminal global hotkey" />
          <Button
              Grid.Column="1"
              Classes="SecondaryButton"
              Click="OnRecordHotkeyClick"
              Content="Record"
              AutomationProperties.Name="Record Quick Terminal global hotkey" />
        </Grid>
      </controls:SettingRow>
      <controls:SettingsGroup.Footer>
        <Grid
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{DynamicResource ShellSpaceSm}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding QuickTerminalSettingsEditor.RegistrationStatus}">
          <Ellipse
              Width="8"
              Height="8"
              VerticalAlignment="Center"
              Fill="{Binding QuickTerminalSettingsEditor.RegistrationStatusBrush}" />
          <TextBlock
              Grid.Column="1"
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="{Binding QuickTerminalSettingsEditor.RegistrationStatus}"
              TextWrapping="Wrap" />
        </Grid>
      </controls:SettingsGroup.Footer>
    </controls:SettingsGroup>

    <controls:SettingsGroup
        Heading="Display &amp; size"
        Description="Choose which display receives the panel and how much of its working area it covers."
        ControlWidth="280">
      <controls:SettingRow
          Label="Show on display"
          Description="Active window follows whichever app is in front and falls back to Asura where unsupported. Asura window follows this app; Primary always uses the OS primary display.">
        <ComboBox
            ItemsSource="{Binding QuickTerminalSettingsEditor.MonitorOptions}"
            SelectedItem="{Binding QuickTerminalSettingsEditor.SelectedMonitorOption}"
            AutomationProperties.Name="Quick Terminal display">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </controls:SettingRow>
      <controls:SettingRow
          Label="Panel height"
          Description="Percentage of the selected display's working area.">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <NumericUpDown
              Minimum="25"
              Maximum="90"
              Increment="1"
              FormatString="0"
              Value="{Binding QuickTerminalSettingsEditor.HeightPercent}"
              AutomationProperties.Name="Quick Terminal panel height" />
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Classes="Muted"
              Text="%" />
        </Grid>
      </controls:SettingRow>
    </controls:SettingsGroup>

    <controls:SettingsGroup
        Heading="Background"
        Description="Tune translucency and the compositor-backed blur treatment."
        ControlWidth="280">
      <controls:SettingRow
          Label="Background opacity"
          Description="Opacity of the terminal backdrop; text, cursor, and controls stay crisp.">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <NumericUpDown
              ClipValueToMinMax="True"
              Minimum="0"
              Maximum="100"
              Increment="1"
              Value="{Binding QuickTerminalSettingsEditor.OpacityPercent}"
              AutomationProperties.Name="Quick Terminal background opacity" />
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Classes="Muted"
              Text="%" />
        </Grid>
      </controls:SettingRow>
      <controls:SettingRow
          Label="Translucency"
          Description="Whether the terminal sits on the platform's own material, so the desktop shows through it. The amount of blur is the platform's to decide.">
        <ToggleSwitch
            IsChecked="{Binding QuickTerminalSettingsEditor.IsTranslucent}"
            AutomationProperties.Name="Quick Terminal translucency" />
      </controls:SettingRow>
      <controls:SettingsGroup.Footer>
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="Some platforms expose only on/off blur, so Asura applies the stored radius at the nearest supported level."
            TextWrapping="Wrap" />
      </controls:SettingsGroup.Footer>
    </controls:SettingsGroup>

    <controls:SettingsGroup
        Heading="Motion &amp; behavior"
        Description="Control how the panel enters, leaves, and retains its terminal session."
        ControlWidth="280">
      <controls:SettingRow
          Label="Animate the drop-down"
          Description="Slide the panel in and out instead of snapping.">
        <ToggleSwitch
            HorizontalAlignment="Right"
            IsChecked="{Binding QuickTerminalSettingsEditor.AnimateSlide}"
            AutomationProperties.Name="Animate Quick Terminal" />
      </controls:SettingRow>
      <controls:SettingRow
          Label="Reduce motion"
          Description="Disable slide animation even when animation is enabled.">
        <ToggleSwitch
            HorizontalAlignment="Right"
            IsChecked="{Binding QuickTerminalSettingsEditor.ReduceMotion}"
            AutomationProperties.Name="Reduce Quick Terminal motion" />
      </controls:SettingRow>
      <controls:SettingRow
          Label="Animation duration"
          Description="Slide duration in milliseconds when motion is enabled.">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <NumericUpDown
              Minimum="0"
              Maximum="1000"
              Increment="10"
              Value="{Binding QuickTerminalSettingsEditor.AnimationDurationMilliseconds}"
              AutomationProperties.Name="Quick Terminal animation duration" />
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Classes="Muted"
              Text="ms" />
        </Grid>
      </controls:SettingRow>
      <controls:SettingRow
          Label="Hide on focus loss"
          Description="Dismiss the panel when focus moves to another application.">
        <ToggleSwitch
            HorizontalAlignment="Right"
            IsChecked="{Binding QuickTerminalSettingsEditor.HideOnFocusLoss}"
            AutomationProperties.Name="Hide Quick Terminal on focus loss" />
      </controls:SettingRow>
      <controls:SettingRow
          Label="Keep terminal session"
          Description="Retain the terminal and scrollback between openings. Turning this off starts a fresh shell next time.">
        <ToggleSwitch
            HorizontalAlignment="Right"
            IsChecked="{Binding QuickTerminalSettingsEditor.RestoreLastSession}"
            AutomationProperties.Name="Keep Quick Terminal session" />
      </controls:SettingRow>
      <controls:SettingRow
          Label="Restore on start"
          Description="Reopen Quick Terminal tabs and their connections when Asura starts, like main-window session restore.">
        <ToggleSwitch
            HorizontalAlignment="Right"
            IsChecked="{Binding QuickTerminalSettingsEditor.RestoreOnStart}"
            AutomationProperties.Name="Restore Quick Terminal on start" />
      </controls:SettingRow>
      <controls:SettingsGroup.Footer>
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="Escape always hides the Quick Terminal panel."
            TextWrapping="Wrap" />
      </controls:SettingsGroup.Footer>
    </controls:SettingsGroup>
  </StackPanel>
</UserControl>
