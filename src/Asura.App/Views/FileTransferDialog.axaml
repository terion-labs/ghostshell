<Window
    x:Class="Asura.App.Views.FileTransferDialog"
    x:DataType="vm:FileTransferEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    Width="620"
    Height="430"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Queue transfer">
  <controls:DialogShell
      Title="Queue file transfer"
      Subtitle="Review and manage file transfers.">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" />
        <Button Classes="PrimaryButton" Click="OnQueueClick" Content="Queue transfer" />
      </StackPanel>
    </controls:DialogShell.Footer>

    <StackPanel Spacing="{DynamicResource ShellSpaceLg}">
      <controls:Callout x:Name="ValidationCard" Tone="Danger" Glyph="ErrorCircle" IsVisible="False">
        <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource ShellDangerBrush}" TextWrapping="Wrap" />
      </controls:Callout>
      <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Eyebrow" Text="Source" />
          <TextBlock Text="{Binding Source.Name}" />
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SourceLocation}" />
        </StackPanel>
      </controls:SurfaceCard>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <controls:LabeledField Label="Operation">
          <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" />
        </controls:LabeledField>
        <controls:LabeledField Grid.Column="1" Label="When destination exists">
          <ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding ConflictPolicy}" />
        </controls:LabeledField>
      </Grid>
      <controls:LabeledField Label="Destination provider">
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedDestinationProfile}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      </controls:LabeledField>
      <controls:LabeledField
          Label="Destination location"
          Hint="The location is parsed into a structured provider address; it is never appended to a local command string.">
        <TextBox Text="{Binding Destination}" />
      </controls:LabeledField>
    </StackPanel>
  </controls:DialogShell>
</Window>
