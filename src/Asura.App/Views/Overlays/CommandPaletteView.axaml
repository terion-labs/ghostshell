<UserControl
    x:Class="Asura.App.Views.Overlays.CommandPaletteView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <controls:SurfaceCard Elevation="Overlay" Padding="0"
      Width="680"
      MaxHeight="700"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      KeyboardNavigation.TabNavigation="Cycle">
    <Grid RowDefinitions="58,*,44">
      <Grid Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <icons:SymbolIcon VerticalAlignment="Center" Symbol="Search" FontSize="17" />
        <TextBox
            x:Name="CommandSearchBox"
            Grid.Column="1"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            BorderThickness="0"
            Background="Transparent"
            KeyDown="OnSearchKeyDown"
            PlaceholderText="Search connections, screens, workspaces, sessions, or commands…"
            AutomationProperties.Name="Search commands and launch targets"
            Text="{Binding LauncherSearchQuery}" />
        <Button Grid.Column="2" Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="OnCloseClick" AutomationProperties.Name="Close command palette">
          <Border Classes="Keycap">
            <TextBlock Text="Esc" />
          </Border>
        </Button>
      </Grid>
      <ListBox
          x:Name="LauncherSearchResultList"
          Grid.Row="1"
          Background="Transparent"
          BorderThickness="0"
          AutomationProperties.Name="Commands and launch targets"
          ItemsSource="{Binding LauncherSearchResults}"
          SelectedItem="{Binding SelectedLauncherSearchResult, Mode=TwoWay}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:LauncherSearchResultViewModel">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
          </Style>
          <!--
            The row is a button inside a list item and both light up on hover,
            one inset inside the other, which reads as a doubled rectangle
            rather than a highlighted row. The item owns the highlight: it is
            the full width of the row, and the button is what is clicked.
          -->
          <Style Selector="ListBoxItem > Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button
                Padding="{controls:Inset Sm}"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Click="OnActivateSearchResultClick"
                IsEnabled="{Binding IsAvailable}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <Border Width="34" Height="34" VerticalAlignment="Center" Classes="IconTile">
                  <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="{Binding IconSymbol}" FontSize="14" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock Classes="SectionHeading" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Group}" />
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DisplayDetail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" Classes="Keycap" VerticalAlignment="Center" IsVisible="{Binding HasTrailingText}">
                  <TextBlock Text="{Binding TrailingText}" />
                </Border>
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel
          Grid.Row="1"
          Margin="{controls:Inset Xxl}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="{DynamicResource ShellSpaceSm}"
          IsVisible="{Binding HasNoLauncherSearchResults}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="Launcher search has no results">
        <icons:SymbolIcon HorizontalAlignment="Center" Symbol="Search" FontSize="24" />
        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No results" />
        <TextBlock MaxWidth="420" HorizontalAlignment="Center" Classes="Muted" TextAlignment="Center" Text="{Binding LauncherSearchEmptyState}" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Row="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Unavailable results stay visible but cannot be opened." />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="↑↓ navigate ↵ activate" />
        </Grid>
      </Border>
    </Grid>
  </controls:SurfaceCard>
</UserControl>
