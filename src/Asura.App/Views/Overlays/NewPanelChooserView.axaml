<UserControl
    x:Class="Asura.App.Views.Overlays.NewPanelChooserView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <controls:SurfaceCard Elevation="Overlay" Padding="0"
      Width="900"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      KeyboardNavigation.TabNavigation="Cycle">
    <StackPanel Margin="{controls:Inset Xl}" Spacing="{DynamicResource ShellSpaceLg}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock FontSize="{DynamicResource ShellFontSize20}" FontWeight="SemiBold" Text="Add a panel" />
          <TextBlock Classes="Muted" Text="Choose an adapter supported by this desktop milestone." />
        </StackPanel>
        <Button Grid.Column="1" Classes="IconButton" Click="OnCloseClick" AutomationProperties.Name="Close panel chooser">
          <icons:SymbolIcon Symbol="Dismiss" FontSize="14" />
        </Button>
      </Grid>
      <controls:CardGridPanel MinItemWidth="128" Spacing="{DynamicResource ShellSpaceSm}">
        <controls:ChooserTile x:Name="NewPanelTerminalButton" Icon="WindowConsole" Title="Terminal" Description="Local PTY" Click="OnAddTerminalPanelClick" />
        <controls:ChooserTile Icon="Globe" Title="Browser" Description="Embedded Chromium" Click="OnAddBrowserPanelClick" IsEnabled="{Binding CanCreateBrowserPanel}" AutomationProperties.Name="Add browser panel" />
        <controls:ChooserTile Icon="PulseSquare" Title="Statistics" Description="Live metrics" Click="OnAddStatisticsPanelClick" AutomationProperties.Name="Add Statistics panel" />
        <controls:ChooserTile Icon="Folder" Title="Files" Description="Saved providers" Click="OnAddFilePanelClick" />
        <controls:ChooserTile Icon="Gauge" Title="Processes" Description="Running processes" Click="OnAddProcessMonitorPanelClick" AutomationProperties.Name="Add Process Monitor panel" />
        <controls:ChooserTile Icon="Database" Title="Database" Description="SQL viewer" Click="OnAddDatabasePanelClick" AutomationProperties.Name="Add database panel" />
        <controls:ChooserTile Icon="Box" Title="Docker" Description="Containers &amp; images" Click="OnAddDockerPanelClick" AutomationProperties.Name="Add Docker panel" />
        <controls:ChooserTile Icon="BranchFork" Title="Git" Description="Stage, commit &amp; history" Click="OnAddGitPanelClick" AutomationProperties.Name="Add Git panel" />
      </controls:CardGridPanel>
      <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceLg}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="Browser profile" />
            <TextBlock Classes="Muted" Text="Pinned only for the new browser panel" />
          </StackPanel>
          <ComboBox
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding BrowserPanelProfileOptions}"
              SelectedItem="{Binding SelectedBrowserPanelProfile, Mode=TwoWay}"
              AutomationProperties.Name="Profile for new browser panel">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="Muted" Text="{Binding Detail}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </controls:SurfaceCard>
      <!-- A new panel is not only a blank adapter: a saved connection or screen
           is just as likely to be what belongs here, so both are offered
           alongside the adapters rather than behind another navigation step. -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceLg}">
        <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
          <components:SectionHeader Heading="Connections" Count="{Binding Connections.Count}" />
          <!-- Five rows exactly. A height that ends mid-row reads as a clipped
               list rather than a scrollable one. -->
          <controls:SurfaceCard Padding="0" Grid.Row="1">
            <ScrollViewer MaxHeight="210" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Classes="StretchItems" ItemsSource="{Binding Connections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button
                        Classes="ListRow"
                        Click="OnAddConnectionPanelClick"
                        IsEnabled="{Binding CanOpen}"
                        AutomationProperties.Name="{Binding Name, StringFormat=Open saved connection {0} in this panel}">
                      <controls:ListItem
                          ContentPadding="{controls:Inset Horizontal=Md, Vertical=Sm}"
                          Title="{Binding Name}"
                          Detail="{Binding Detail}">
                        <controls:ListItem.Leading>
                          <Border VerticalAlignment="Center" Classes="StatusDot" Classes.available="{Binding CanOpen}" />
                        </controls:ListItem.Leading>
                        <controls:ListItem.Trailing>
                          <components:CountPill Value="{Binding Kind}" />
                        </controls:ListItem.Trailing>
                      </controls:ListItem>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </controls:SurfaceCard>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
          <components:SectionHeader Heading="Screens" Count="{Binding Screens.Count}" />
          <controls:SurfaceCard Padding="0" Grid.Row="1">
            <ScrollViewer MaxHeight="210" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Classes="StretchItems" ItemsSource="{Binding Screens}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button
                        Classes="ListRow"
                        Click="OnOpenScreenClick"
                        AutomationProperties.Name="{Binding Name, StringFormat=Open saved screen {0} in a tab}">
                      <controls:ListItem
                          ContentPadding="{controls:Inset Horizontal=Md, Vertical=Sm}"
                          Title="{Binding Name}"
                          Detail="{Binding Summary}">
                        <controls:ListItem.Leading>
                          <Border Width="26" Height="26" Classes="IconTile Neutral"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Grid" FontSize="12" /></Border>
                        </controls:ListItem.Leading>
                        <controls:ListItem.Trailing>
                          <components:CountPill Value="{Binding PanelCount, StringFormat={}{0} panels}" />
                        </controls:ListItem.Trailing>
                      </controls:ListItem>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </controls:SurfaceCard>
        </Grid>
      </Grid>

      <Button Classes="TextButton Accent" Click="OnShowLayoutDesignerClick" Content="Open layout designer instead" />
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
