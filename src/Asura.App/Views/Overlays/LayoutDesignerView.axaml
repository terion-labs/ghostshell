<UserControl
    x:Class="Asura.App.Views.Overlays.LayoutDesignerView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:dockDocuments="using:Dock.Model.Inpc.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:vm="using:Asura.App.ViewModels"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.DataTemplates>
    <!--
      One designer slot, rendered inside its Dock document. The header is the
      drag surface — exactly the runtime panel contract — so rearranging a
      designed layout is the same gesture as rearranging a live workspace.
    -->
    <DataTemplate DataType="vm:LayoutDesignerSlotViewModel">
      <controls:SurfaceCard
          Tone="Sunken"
          ClipsContent="True"
          Padding="0"
          Classes.active="{Binding IsSelected}"
          PointerPressed="OnLayoutSlotPointerPressed">
        <Grid RowDefinitions="32,*">
          <Border Classes="PanelHeader">
            <Grid Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <Border
                  Width="20"
                  Height="20"
                  VerticalAlignment="Center"
                  Classes="LayoutSlotBadge"
                  Classes.orange="{Binding UsesOrangePalette}"
                  Classes.blue="{Binding UsesBluePalette}"
                  Classes.green="{Binding UsesGreenPalette}"
                  Classes.pink="{Binding UsesPinkPalette}"
                  CornerRadius="{DynamicResource ShellInnerCornerRadius}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ShellFontSize10}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ShellBackgroundBrush}"
                    Text="{Binding Order}" />
              </Border>
              <controls:PanelDockHandle
                  x:DataType="dockDocuments:Document"
                  Grid.Column="1"
                  DataContext="{Binding $parent[dock:DockableControl].DataContext}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ShellFontSize11}"
                    FontWeight="SemiBold"
                          Text="{Binding ((vm:LayoutDesignerSlotViewModel)Context).OrderLabel}" />
              </controls:PanelDockHandle>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
                <Button
                    Classes="IconButton"
                    Click="OnLayoutSplitSlotRightClick"
                    ToolTip.Tip="Split left/right"
                    AutomationProperties.Name="{Binding OrderLabel, StringFormat={}Split {0} left and right}">
                  <icons:SymbolIcon FontSize="12" Symbol="SplitVertical" />
                </Button>
                <Button
                    Classes="IconButton"
                    Click="OnLayoutSplitSlotDownClick"
                    ToolTip.Tip="Split top/bottom"
                    AutomationProperties.Name="{Binding OrderLabel, StringFormat={}Split {0} top and bottom}">
                  <icons:SymbolIcon FontSize="12" Symbol="SplitHorizontal" />
                </Button>
                <Button
                    Classes="IconButton"
                    Click="OnLayoutRemoveSlotClick"
                    ToolTip.Tip="Remove panel"
                    AutomationProperties.Name="{Binding OrderLabel, StringFormat={}Remove {0}}">
                  <icons:SymbolIcon FontSize="12" Symbol="Dismiss" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock
                HorizontalAlignment="Center"
                
                FontSize="{DynamicResource ShellFontSize16}"
                FontWeight="Bold"
                Text="{Binding SizeLabel}" />
            <TextBlock
                HorizontalAlignment="Center"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                Text="{Binding OrderLabel}" />
          </StackPanel>
        </Grid>
      </controls:SurfaceCard>
    </DataTemplate>
  </UserControl.DataTemplates>

  <controls:SurfaceCard Elevation="Overlay" Padding="0" Width="1000" Height="648" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
    <Grid RowDefinitions="60,Auto,*,60">
      <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceMd}">
            <Border Width="30" Height="30" Background="{DynamicResource ShellAccentSoftBrush}" CornerRadius="{DynamicResource ShellControlCornerRadius}">
              <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Grid" FontSize="16" Foreground="{DynamicResource ShellAccentBrush}" />
            </Border>
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontSize="{DynamicResource ShellFontSize16}" FontWeight="Bold" Text="Design custom layout" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="Split, drag, and resize panels — the canvas works like the workspace" />
            </StackPanel>
            <!-- Only news is worth a badge: "saved" is the resting state, and
                 a label saying so was furniture. -->
            <Border Classes="Keycap" IsVisible="{Binding LayoutDesignerEditor.IsDirty}"><TextBlock Text="{Binding LayoutDesignerEditor.DirtyStatus}" /></Border>
          </StackPanel>
          <Button Grid.Column="1" Classes="IconButton" Click="OnCloseOverlayClick" AutomationProperties.Name="Close layout designer">
            <icons:SymbolIcon Symbol="Dismiss" FontSize="16" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="Layout name" />
            <TextBox x:Name="NewLayoutName" Text="{Binding LayoutDesignerEditor.Name, Mode=TwoWay}" PlaceholderText="My layout" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Bottom" Classes="SecondaryButton" Click="OnResetLayoutClick" Content="Reset" ToolTip.Tip="Restore the saved layout" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,300">
        <Border Background="{DynamicResource ShellBackgroundBrush}">
          <Grid Margin="{controls:Inset Lg}" RowDefinitions="*,Auto" RowSpacing="{DynamicResource ShellSpaceMd}">
            <Border
                Background="{DynamicResource ShellBackgroundBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ShellCardCornerRadius}"
                ClipToBounds="True">
              <dock:DockControl
                  x:Name="LayoutDesignerDock"
                  Margin="{controls:Inset Xs}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Layout="{Binding LayoutDesignerEditor.DockLayout}"
                  Factory="{Binding LayoutDesignerEditor.DockFactory}"
                  IsDockingEnabled="True"
                  InitializeFactory="True"
                  InitializeLayout="False"
                  AutomationProperties.Name="Editable layout canvas" />
            </Border>
            <Border Grid.Row="1" HorizontalAlignment="Center" Padding="{controls:Inset Horizontal=Md, Vertical=Sm}" Background="{DynamicResource ShellSurfaceRaisedBrush}" CornerRadius="{DynamicResource ShellPillCornerRadius}">
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellPillFontSize}" Text="{Binding LayoutDesignerEditor.GridHint}" />
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
              <components:SectionHeader Heading="Panels" Count="{Binding LayoutDesignerEditor.PanelCount}" />

              <ItemsControl ItemsSource="{Binding LayoutDesignerEditor.Slots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button
                        Margin="{controls:Inset Bottom=Xs}"
                        Padding="{controls:Inset Sm}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Classes="SecondaryButton"
                        Classes.active="{Binding IsSelected}"
                        Click="OnLayoutSlotClick"
                        AutomationProperties.Name="{Binding OrderLabel}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                        <Border
                            Width="24"
                            Height="24"
                            Classes="LayoutSlotBadge"
                            Classes.orange="{Binding UsesOrangePalette}"
                            Classes.blue="{Binding UsesBluePalette}"
                            Classes.green="{Binding UsesGreenPalette}"
                            Classes.pink="{Binding UsesPinkPalette}"
                            CornerRadius="{DynamicResource ShellControlCornerRadius}">
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource ShellBackgroundBrush}" Text="{Binding Order}" />
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding OrderLabel}" />
                        <components:CountPill Grid.Column="2" Value="{Binding SizeLabel}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button
                  HorizontalAlignment="Stretch"
                  Classes="SecondaryButton"
                  Click="OnLayoutAddSlotClick"
                  AutomationProperties.Name="Add a panel">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon Symbol="Add" FontSize="14" />
                  <TextBlock Text="Add panel" />
                </StackPanel>
              </Button>

              <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}">
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Panels are generic regions — assign connections later when you open the screen." TextWrapping="Wrap" />
              </controls:SurfaceCard>

              <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}" IsVisible="{Binding LayoutDesignerEditor.HasOperationError}">
                <controls:LiveRegionTextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding LayoutDesignerEditor.LastOperationIssue.Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Layout designer status" />
              </controls:SurfaceCard>
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding LayoutDesignerEditor.ValidationSummary}" TextWrapping="Wrap" />

              <TextBlock Classes="SectionHeading" Text="Saved layouts" />
              <ItemsControl ItemsSource="{Binding Layouts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Margin="{controls:Inset Bottom=Xs}" Padding="{controls:Inset Sm}" Classes="SecondaryButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnEditLayoutClick">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                        <Border Width="44" Height="28" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellInnerCornerRadius}" ClipToBounds="True">
                          <ItemsControl Margin="{DynamicResource ShellPreviewTileInset}" ItemsSource="{Binding PreviewPanels}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ScreenLayoutPreviewPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Margin="{DynamicResource ShellHairlineInset}" Classes="ScreenPreviewPanel" Classes.primary="{Binding IsPrimary}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding SlotCount, StringFormat={}{0} slots}" TextAlignment="Right" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Grid.Row="3" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
          <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding LayoutDesignerEditor.GridSummary}" />
          <Button Grid.Column="1" VerticalAlignment="Center" Classes="SecondaryButton" Click="OnCloseOverlayClick" Content="Cancel" />
          <Button Grid.Column="2" VerticalAlignment="Center" Classes="PrimaryButton" Click="OnSaveLayoutDesignerClick" Content="Save layout" IsEnabled="{Binding LayoutDesignerEditor.CanSave}" />
        </Grid>
      </Border>
    </Grid>
  </controls:SurfaceCard>
</UserControl>
