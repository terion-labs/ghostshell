<Window
    x:Class="Asura.App.Views.McpServerTrustConfirmationDialog"
    x:DataType="vm:McpServerTrustReview"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    Title="Trust MCP server changes"
    Width="620"
    MinWidth="500"
    MaxHeight="820"
    SizeToContent="Height"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Opened="OnOpened">
  <controls:DialogShell Chrome="Utility" Title="Trust MCP server changes">
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock
            FontSize="{DynamicResource ShellFontSize18}"
            FontWeight="SemiBold"
            Text="Trust these MCP server changes?"
            TextWrapping="Wrap" />
        <TextBlock
            Classes="Muted"
            Text="{Binding ServerName, StringFormat={}Review the changes to “{0}” before saving.}"
            TextWrapping="Wrap" />
      </StackPanel>

      <controls:Callout
          Tone="Warning"
          Glyph="Warning"
          IsVisible="{Binding IsStdio}"
          Title="Run a local server"
          Text="Asura will run this executable and pass the selected environment variables."
          Footnote="Review the executable, arguments, and variable names before allowing it." />

      <controls:Callout
          Tone="Warning"
          Glyph="Warning"
          IsVisible="{Binding IsStreamableHttp}"
          Title="Connect to a remote server"
          Text="Asura will connect to this address and send the selected HTTP headers."
          Footnote="Review the address and header names before allowing it." />

      <controls:SurfaceCard
          Padding="{DynamicResource ShellCardPaddingCompact}"
          IsVisible="{Binding IsStdio}">
        <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
          <TextBlock Classes="SectionHeading" Text="Changes" />
          <ItemsControl ItemsSource="{Binding Changes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="{controls:Inset Top=Xs}" Text="{Binding StringFormat={}• {0}}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </controls:SurfaceCard>

      <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}">
        <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
          <TextBlock Classes="SectionHeading" Text="Direct launch" />
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Eyebrow" Text="Executable" />
            <TextBox
                IsReadOnly="True"
                Text="{Binding Executable}"
                AutomationProperties.Name="Trusted MCP executable" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Eyebrow" Text="Working directory" />
            <TextBox
                IsReadOnly="True"
                Text="{Binding WorkingDirectory}"
                AutomationProperties.Name="Trusted MCP working directory" />
          </StackPanel>
          <TextBlock Classes="Eyebrow" Margin="{controls:Inset Top=Xs}" Text="Ordered arguments" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              IsVisible="{Binding HasNoArguments}"
              Text="No arguments" />
          <ItemsControl ItemsSource="{Binding Arguments}" IsVisible="{Binding HasArguments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="{controls:Inset Top=Xs}" ColumnDefinitions="100,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </controls:SurfaceCard>

      <controls:SurfaceCard
          Padding="{DynamicResource ShellCardPaddingCompact}"
          IsVisible="{Binding IsStreamableHttp}">
        <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
          <TextBlock Classes="SectionHeading" Text="Remote endpoint" />
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Eyebrow" Text="Endpoint" />
            <TextBox
                IsReadOnly="True"
                Text="{Binding Endpoint}"
                AutomationProperties.Name="Trusted MCP Streamable HTTP endpoint" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Eyebrow" Text="Transport security" />
            <TextBlock
                FontSize="{DynamicResource ShellFontSize10}"
                Text="{Binding TransportSecurity}"
                TextWrapping="Wrap"
                AutomationProperties.Name="Trusted MCP transport security" />
          </StackPanel>
        </StackPanel>
      </controls:SurfaceCard>

      <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}">
        <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
          <StackPanel IsVisible="{Binding IsStdio}" Spacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Classes="SectionHeading" Text="Environment credentials" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                IsVisible="{Binding HasNoEnvironment}"
                Text="No environment bindings" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                IsVisible="{Binding HasEnvironment}"
                Text="Credential values are never shown."
                TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Environment}" IsVisible="{Binding HasEnvironment}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                      Margin="{controls:Inset Top=Xs}"
                      Padding="{controls:Inset Sm}"
                      BorderBrush="{DynamicResource ShellBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource ShellControlCornerRadius}"
                      AutomationProperties.Name="{Binding AutomationName}">
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <TextBlock
                          FontSize="{DynamicResource ShellFontSize10}"
                          Text="{Binding BindingName}"
                          TextWrapping="Wrap" />
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellFontSize9}"
                            Text="{Binding ReferenceValue, StringFormat={}Credential · {0}}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="{DynamicResource ShellFontSize10}"
                            Text="{Binding MetadataSummary}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellFontSize9}"
                            Text="{Binding StateSummary}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsStreamableHttp}" Spacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Classes="SectionHeading" Text="HTTP header credentials" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                IsVisible="{Binding HasNoHttpHeaders}"
                Text="No secret HTTP headers" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                IsVisible="{Binding HasHttpHeaders}"
                Text="Header values are never shown."
                TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding HttpHeaders}" IsVisible="{Binding HasHttpHeaders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                      Margin="{controls:Inset Top=Xs}"
                      Padding="{controls:Inset Sm}"
                      BorderBrush="{DynamicResource ShellBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource ShellControlCornerRadius}"
                      AutomationProperties.Name="{Binding AutomationName}">
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <TextBlock
                          FontSize="{DynamicResource ShellFontSize10}"
                          Text="{Binding BindingName}"
                          TextWrapping="Wrap" />
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellFontSize9}"
                            Text="{Binding ReferenceValue, StringFormat={}Credential · {0}}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="{DynamicResource ShellFontSize10}"
                            Text="{Binding MetadataSummary}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellFontSize9}"
                            Text="{Binding StateSummary}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Classes="SectionHeading" Margin="{controls:Inset Top=Xs}" Text="Enabled tools" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              IsVisible="{Binding HasNoEnabledTools}"
              Text="No tools enabled" />
          <ItemsControl ItemsSource="{Binding EnabledTools}" IsVisible="{Binding HasEnabledTools}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="{controls:Inset Top=Xs}" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding StringFormat={}• {0}}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </controls:SurfaceCard>

      <CheckBox
          x:Name="Acknowledgement"
          Click="OnAcknowledgementChanged"
          AutomationProperties.Name="I reviewed this MCP server, its credentials, and enabled tools"
          AutomationProperties.HelpText="Required before saving these MCP server changes">
        <TextBlock
            Text="I reviewed this server, its credentials, and enabled tools."
            TextWrapping="Wrap" />
      </CheckBox>
    </StackPanel>

    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button
            Classes="SecondaryButton"
            Click="OnCancelClick"
            Content="Cancel"
            IsCancel="True"
            AutomationProperties.Name="Cancel MCP trust confirmation" />
        <Button
            x:Name="ConfirmButton"
            Classes="PrimaryButton"
            Click="OnConfirmClick"
            Content="Trust and save"
            IsEnabled="False"
            IsDefault="True"
            AutomationProperties.Name="Trust and save MCP server changes" />
      </StackPanel>
    </controls:DialogShell.Footer>
  </controls:DialogShell>
</Window>
