<UserControl
    x:Class="Asura.App.Views.DiagnosticsExportView"
    x:DataType="vm:DiagnosticsExportViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    MinWidth="560">
  <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontSize="{DynamicResource ShellFontSize18}" FontWeight="SemiBold" Text="Diagnostics bundle" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Create a support archive after reviewing what it contains." TextWrapping="Wrap" />
      </StackPanel>
      <controls:StatusChip Grid.Column="1" VerticalAlignment="Center" Classes.Warning="{Binding IsWarning}" IsVisible="{Binding HasStatus}" Content="{Binding StatusLabel}" />
    </Grid>

    <controls:SurfaceCard>
      <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
        <TextBlock Classes="SectionHeading" Text="Content and redaction" />
        <controls:LabeledField
            Label="Diagnostic detail"
            Hint="{Binding SelectedRedactionDescription}">
          <ComboBox
              ItemsSource="{Binding RedactionOptions}"
              SelectedItem="{Binding SelectedRedactionOption, Mode=TwoWay}"
              IsEnabled="{Binding CanChooseRedactionLevel}"
              AutomationProperties.Name="Diagnostics detail and redaction level">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </controls:LabeledField>

        <controls:Callout
            Tone="Notice"
            Glyph="Shield"
            Title="Secret-safe by construction"
            Text="{Binding RedactionAvailabilityMessage}"
            Footnote="Terminal contents, commands, credentials, environment values, and secret material are never eligible artifacts." />

        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <Button
              MinWidth="138"
              Classes="PrimaryButton"
              Click="OnExportClick"
              Content="Create bundle…"
              IsEnabled="{Binding CanExport}"
              AutomationProperties.Name="Create diagnostics bundle" />
          <Button
              Grid.Column="1"
              MinWidth="82"
              Click="OnCancelClick"
              Content="Cancel"
              IsEnabled="{Binding CanCancel}"
              IsVisible="{Binding CanCancel}"
              AutomationProperties.Name="Cancel diagnostics export" />
          <ProgressBar
              Grid.Column="2"
              MinWidth="120"
              VerticalAlignment="Center"
              IsIndeterminate="True"
              IsVisible="{Binding IsExporting}"
              AutomationProperties.Name="Diagnostics export progress" />
        </Grid>
      </StackPanel>
    </controls:SurfaceCard>

    <controls:Callout Tone="Notice" Glyph="Info" IsVisible="{Binding HasStatus}">
      <controls:LiveRegionTextBlock
          Text="{Binding StatusMessage}"
          TextWrapping="Wrap"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding StatusAutomationName}" />
    </controls:Callout>

    <controls:SurfaceCard IsVisible="{Binding HasArtifact}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="SectionHeading" Text="Last exported bundle" />
          <TextBlock FontWeight="SemiBold" Text="{Binding ArtifactDisplayName}" TextWrapping="Wrap" />
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ReceiptSummary}" />
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DigestSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Button
            Grid.Column="1"
            MinWidth="82"
            VerticalAlignment="Center"
            Classes="SecondaryButton"
            Click="OnOpenClick"
            Content="Open"
            IsEnabled="{Binding CanOpenArtifact}"
            AutomationProperties.Name="Open last diagnostics bundle" />
        <Button
            Grid.Column="2"
            MinWidth="112"
            VerticalAlignment="Center"
            Classes="SecondaryButton"
            Click="OnRevealClick"
            Content="Show in folder"
            IsEnabled="{Binding CanRevealArtifact}"
            AutomationProperties.Name="Reveal last diagnostics bundle in file manager" />
      </Grid>
    </controls:SurfaceCard>
  </StackPanel>
</UserControl>
