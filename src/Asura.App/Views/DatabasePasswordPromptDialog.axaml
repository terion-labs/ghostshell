<Window
    x:Class="Asura.App.Views.DatabasePasswordPromptDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    Width="400"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ShellBackgroundBrush}"
    Title="Database password">
  <StackPanel Margin="{controls:Inset Xl}" Spacing="{DynamicResource ShellSpaceMd}">
    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
      <TextBlock x:Name="PromptTitle" FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="Database password" />
      <TextBlock x:Name="PromptDescription" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="This connection is saved without a password. It is used for this session only." TextWrapping="Wrap" />
    </StackPanel>
    <TextBox
        x:Name="PasswordInput"
        PasswordChar="•"
        PlaceholderText="password"
        KeyDown="OnPasswordKeyDown"
        TextChanged="OnPasswordTextChanged"
        AutomationProperties.Name="Database password" />
    <CheckBox
        x:Name="SavePasswordCheckBox"
        IsChecked="False"
        IsEnabled="False"
        IsVisible="False"
        Content="Save in system credential store"
        AutomationProperties.Name="Save password in system credential store" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button MinWidth="88" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" AutomationProperties.Name="Cancel the password prompt" />
      <Button MinWidth="112" Classes="PrimaryButton" Click="OnConnectClick" Content="Connect" AutomationProperties.Name="Connect with this password" />
    </StackPanel>
  </StackPanel>
</Window>
