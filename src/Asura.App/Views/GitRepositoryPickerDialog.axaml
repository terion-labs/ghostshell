<Window
    x:Class="Asura.App.Views.GitRepositoryPickerDialog"
    x:DataType="vm:GitRepositoryPickerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Width="620"
    Height="520"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Open Git repository">
  <controls:DialogShell
      Title="Open Git repository"
      Subtitle="{Binding ConnectionDisplayName, StringFormat=Browsing {0}. Folders holding a repository are marked.}">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" />
        <Button Classes="PrimaryButton" Click="OnOpenClick" Content="Open repository" />
      </StackPanel>
    </controls:DialogShell.Footer>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceXs}">
        <Button
            Classes="IconButton"
            Click="OnNavigateUpClick"
            IsEnabled="{Binding CanNavigateUp}"
            ToolTip.Tip="Parent folder"
            AutomationProperties.Name="Go to parent folder">
          <icons:SymbolIcon Symbol="ArrowUp" FontSize="14" />
        </Button>
        <TextBox
            Grid.Column="1"
            Text="{Binding PathInput, Mode=TwoWay}"
            KeyDown="OnPathKeyDown"
            AutomationProperties.Name="Directory path" />
      </Grid>

      <controls:Callout
          Grid.Row="1"
          Tone="Danger"
          Title="Cannot open folder"
          Text="{Binding IssueMessage}"
          IsVisible="{Binding HasIssue}" />

      <ListBox
          Grid.Row="2"
          Classes="Rows"
          ItemsSource="{Binding Directories}"
          SelectedItem="{Binding SelectedDirectory, Mode=TwoWay}"
          DoubleTapped="OnDirectoryDoubleTapped"
          AutomationProperties.Name="Folders">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <controls:ListItem
                ContentPadding="{DynamicResource ShellListRowPadding}"
                Title="{Binding Name}"
                AutomationProperties.Name="{Binding AccessibleSummary}">
              <controls:ListItem.Leading>
                <Panel>
                  <icons:SymbolIcon
                      Symbol="Folder"
                      FontSize="14"
                      Foreground="{DynamicResource ShellMutedBrush}"
                      IsVisible="{Binding !IsRepository}" />
                  <icons:SymbolIcon
                      Symbol="BranchFork"
                      FontSize="14"
                      Foreground="{DynamicResource ShellAccentBrush}"
                      IsVisible="{Binding IsRepository}" />
                </Panel>
              </controls:ListItem.Leading>
              <controls:ListItem.Trailing>
                <controls:StatusChip
                    VerticalAlignment="Center"
                    Shape="Rounded"
                    Tone="Default"
                    Content="Repository"
                    IsVisible="{Binding IsRepository}" />
              </controls:ListItem.Trailing>
            </controls:ListItem>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <controls:StateOverlay
          Grid.Row="2"
          Kind="Empty"
          Heading="No folders here"
          Body="Open this folder as the repository, or go up a level."
          IsVisible="{Binding IsEmpty}" />
      <controls:StateOverlay
          Grid.Row="2"
          Kind="Loading"
          Heading="Reading folder…"
          IsVisible="{Binding IsLoading}" />
    </Grid>
  </controls:DialogShell>
</Window>
