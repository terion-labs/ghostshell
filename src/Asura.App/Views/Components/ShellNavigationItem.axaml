<UserControl
    x:Class="Asura.App.Views.Components.ShellNavigationItem"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    Focusable="False"
    HorizontalContentAlignment="Stretch">
  <Button
      x:Name="NavigationButton"
      HorizontalAlignment="Stretch"
      Classes="NavButton"
      Classes.active="{Binding IsActive, ElementName=Root}"
      Click="OnClick"
      AutomationProperties.Name="{Binding AutomationName, ElementName=Root}">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <icons:SymbolIcon
          x:Name="NavigationIcon"
          VerticalAlignment="Center"
          Symbol="{Binding Icon, ElementName=Root}"
          FontSize="{Binding IconSize, ElementName=Root}" />
      <TextBlock
          VerticalAlignment="Center"
          FontSize="{DynamicResource ShellFontSize13}"
          Text="{Binding Label, ElementName=Root}"
          TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Button>
</UserControl>
