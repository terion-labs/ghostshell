<UserControl
    x:Class="Asura.App.Views.Components.AgentQuestionCardView"
    x:DataType="vm:IAgentWorkspaceHost"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    Focusable="False"
    HorizontalContentAlignment="Stretch">
  <controls:SurfaceCard Tone="Notice"
      x:Name="AgentPendingQuestion"
      Padding="{DynamicResource ShellCardPaddingCompact}"
      Focusable="True"
      KeyboardNavigation.IsTabStop="True"
      IsVisible="{Binding AgentChat.HasPendingQuestion, FallbackValue=False}"
      AutomationProperties.Name="{Binding AgentChat.PendingQuestion.AccessibleName}">
    <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
      <TextBlock Classes="Eyebrow" Text="Input needed" />
      <TextBlock Text="{Binding AgentChat.PendingQuestion.Question}" TextWrapping="Wrap" />
      <TextBlock
          Classes="Muted"
          FontSize="{DynamicResource ShellFontSize9}"
          Text="{Binding AgentChat.PendingQuestion.ExpiresAt, StringFormat={}Expires · {0}}"
          TextWrapping="Wrap" />
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock Classes="Eyebrow" Text="Your answer" />
        <TextBox
            x:Name="AgentQuestionResponseInput"
            MinHeight="36"
            Padding="{controls:Inset Sm}"
            AcceptsReturn="False"
            MaxLength="2048"
            Text="{Binding AgentChat.QuestionResponseDraft, Mode=TwoWay}"
            TextWrapping="NoWrap"
            IsEnabled="{Binding AgentChat.CanRespondToQuestion}"
            KeyDown="OnAgentQuestionResponseKeyDown"
            TabIndex="0"
            AutomationProperties.Name="Answer the AI agent question" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Button
            Classes="SecondaryButton"
            Click="OnDeclineAgentQuestionClick"
            Content="Skip / decline"
            IsEnabled="{Binding AgentChat.CanDeclineQuestion}"
            TabIndex="1"
            AutomationProperties.Name="Skip or decline the AI agent question"
            AutomationProperties.HelpText="Continue without answering" />
        <Button
            Grid.Column="1"
            Classes="PrimaryButton"
            Click="OnSubmitAgentQuestionClick"
            Content="Send answer"
            IsEnabled="{Binding AgentChat.CanSubmitQuestionResponse}"
            TabIndex="2"
            AutomationProperties.Name="Send answer to the AI agent" />
      </Grid>
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
