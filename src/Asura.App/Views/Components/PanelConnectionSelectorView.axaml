<UserControl
    x:Class="Asura.App.Views.Components.PanelConnectionSelectorView"
    x:DataType="components:PanelConnectionSelectorView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    Focusable="False">
  <Button
      x:Name="SelectorButton"
      Height="26"
      MinWidth="74"
      MaxWidth="180"
      Padding="{controls:Inset Left=Md, Right=Sm}"
      HorizontalContentAlignment="Stretch"
      Background="{DynamicResource ShellSurfaceRaisedBrush}"
      BorderBrush="{DynamicResource ShellBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource ShellControlCornerRadius}"
      AutomationProperties.Name="{Binding SelectedLabel, ElementName=Root, StringFormat={}Connection: {0}}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
      <TextBlock
          VerticalAlignment="Center"
          FontSize="{DynamicResource ShellFontSize10}"
          FontWeight="SemiBold"
          Text="{Binding SelectedLabel, ElementName=Root}"
          TextTrimming="CharacterEllipsis" />
      <icons:SymbolIcon
          Grid.Column="1"
          VerticalAlignment="Center"
          FontSize="10"
          Symbol="ChevronDown" />
    </Grid>
    <Button.Flyout>
      <Flyout
          Placement="BottomEdgeAlignedLeft"
          Opened="OnFlyoutOpened">
        <Grid Width="310" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceSm}">
          <TextBox
              x:Name="FilterBox"
              TextChanged="OnFilterTextChanged"
              PlaceholderText="Filter connections"
              AutomationProperties.Name="Filter saved connections" />
          <ScrollViewer
              Grid.Row="1"
              MaxHeight="260"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <ItemsControl Classes="StretchItems" ItemsSource="{Binding FilteredOptions, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PanelConnectionOptionViewModel">
                    <Button
                        MinHeight="40"
                        Padding="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnConnectionClick"
                        IsEnabled="{Binding CanOpen}"
                        AutomationProperties.Name="{Binding Name, StringFormat={}Use connection {0}}">
                      <controls:ListItem
                          Title="{Binding Name}"
                          Detail="{Binding Detail}">
                        <controls:ListItem.Trailing>
                          <TextBlock
                              VerticalAlignment="Center"
                              Classes="Eyebrow"
                              FontSize="{DynamicResource ShellFontSize9}"
                              Text="{Binding Kind}" />
                        </controls:ListItem.Trailing>
                      </controls:ListItem>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                  Margin="{controls:Inset Sm}"
                  Classes="Muted"
                  FontSize="{DynamicResource ShellFontSize9}"
                  IsVisible="{Binding HasNoMatches, ElementName=Root}"
                  Text="No matching saved connections." />
            </StackPanel>
          </ScrollViewer>
          <Border
              Grid.Row="2"
              Padding="{controls:Inset Top=Sm}"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              BorderThickness="0,1,0,0">
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Classes="TextButton"
                Click="OnNewConnectionClick"
                AutomationProperties.Name="Create and connect a new connection">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon VerticalAlignment="Center" FontSize="12" Symbol="Add" />
                <TextBlock VerticalAlignment="Center" Text="New connection" />
              </StackPanel>
            </Button>
          </Border>
        </Grid>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
