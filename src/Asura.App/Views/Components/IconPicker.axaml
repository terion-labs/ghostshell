<UserControl
    x:Class="Asura.App.Views.Components.IconPicker"
    x:DataType="components:IconPicker"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels">
  <!--
    Choosing an icon from a catalog too large to read. A shortlist is what the
    control offers unasked; the search and the "All" tile are how you reach the
    rest. Showing all of them at rest turns picking one into scanning a wall.
  -->
  <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
      <TextBox
          x:Name="SearchInput"
          Text="{Binding SearchText, ElementName=Root, Mode=TwoWay}"
          PlaceholderText="Search all icons…"
          AutomationProperties.Name="Search icons">
        <TextBox.InnerLeftContent>
          <icons:SymbolIcon Margin="{controls:Inset Left=Sm}" Symbol="Search" FontSize="13" Foreground="{DynamicResource ShellMutedBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Classes="Muted"
          FontSize="{DynamicResource ShellFontSize11}"
          Text="{Binding TotalCount, ElementName=Root, StringFormat={}{0} icons}" />
    </Grid>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
      <ScrollViewer
          MaxHeight="228"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="Grid" ItemsSource="{Binding ItemsSource, ElementName=Root}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceIconChoiceViewModel">
              <Button
                  Margin="{controls:Inset Right=Xs, Bottom=Xs}"
                  Classes="IconChoice"
                  Click="OnIconClick"
                  ToolTip.Tip="{Binding Name}"
                  Classes.selected="{Binding IsSelected}"
                  AutomationProperties.Name="{Binding Name}">
                <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="{Binding Symbol}" FontSize="16" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <ToggleButton
          x:Name="ShowAllToggle"
          Grid.Column="1"
          VerticalAlignment="Top"
          Classes="IconChoice"
          controls:Concentric.IsEnabled="True"
          IsChecked="{Binding ShowAll, ElementName=Root, Mode=TwoWay}"
          ToolTip.Tip="Show every icon"
          IsVisible="{Binding IsShowAllOffered, ElementName=Root}"
          AutomationProperties.Name="Show every icon">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize10}" Text="All" />
      </ToggleButton>
    </Grid>

    <TextBlock
        Classes="Muted"
        FontSize="{DynamicResource ShellFontSize11}"
        Text="{Binding Hint, ElementName=Root}"
        TextWrapping="Wrap"
        IsVisible="{Binding HasHint, ElementName=Root}" />
  </StackPanel>
</UserControl>
