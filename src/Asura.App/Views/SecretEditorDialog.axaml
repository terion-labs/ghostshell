<Window
    x:Class="Asura.App.Views.SecretEditorDialog"
    x:DataType="vm:SecretEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    Width="560"
    Height="430"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Manage credential">
  <controls:DialogShell
      Title="Manage credential"
      Subtitle="Values stay in the operating-system vault and are never displayed.">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" />
        <Button Classes="SecondaryButton" Click="OnRelabelClick" Content="Save label" />
        <Button Classes="PrimaryButton" Click="OnRotateClick" Content="Rotate value" />
      </StackPanel>
    </controls:DialogShell.Footer>

    <StackPanel Spacing="{DynamicResource ShellSpaceLg}">
      <controls:Callout x:Name="ValidationCard" Tone="Danger" Glyph="ErrorCircle" IsVisible="False">
        <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource ShellDangerBrush}" TextWrapping="Wrap" />
      </controls:Callout>
      <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Eyebrow" Text="Credential ID" />
          <TextBox FontSize="{DynamicResource ShellFontSize9}" IsReadOnly="True" Text="{Binding Secret.Reference.Value}" />
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Secret.Dependencies}" TextWrapping="Wrap" />
        </StackPanel>
      </controls:SurfaceCard>

      <controls:LabeledField
          Label="Label"
          Hint="Changing the label does not change where this credential is used.">
        <TextBox Text="{Binding Label}" />
      </controls:LabeledField>

      <controls:LabeledField
          Label="Replacement value"
          Hint="Rotation replaces the stored value in place, so dependencies do not need editing.">
        <TextBox PasswordChar="●" Text="{Binding ReplacementValue}" PlaceholderText="Enter a new value to rotate" />
      </controls:LabeledField>
    </StackPanel>
  </controls:DialogShell>
</Window>
