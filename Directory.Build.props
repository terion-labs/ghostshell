<Project>
  <PropertyGroup>
    <GhostShellFirstPartyProject>$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('GhostShell'))</GhostShellFirstPartyProject>
    <GhostShellFirstPartySourceProject>$([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)src'))'))</GhostShellFirstPartySourceProject>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <AllowUnsafeBlocks Condition="'$(GhostShellFirstPartyProject)' == 'True' and '$(AllowUnsafeBlocks)' == ''">false</AllowUnsafeBlocks>
    <MeziantouAnalysisMode>Default</MeziantouAnalysisMode>
    <Deterministic>true</Deterministic>
    <DefineConstants Condition="'$(GhostShellProductionBuild)' == 'true'">$(DefineConstants);GHOSTSHELL_PRODUCTION</DefineConstants>
    <!-- Every shipped managed assembly must prove that its reachable code is
         statically analyzable. This runs the trim and Native AOT analyzers at
         the owning project, where a warning still identifies first-party code
         instead of being collapsed into an assembly-level publish warning. -->
    <IsAotCompatible Condition="'$(GhostShellFirstPartySourceProject)' == 'True'">true</IsAotCompatible>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile Condition="'$(GhostShellFirstPartyProject)' == 'True'">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(GhostShellFirstPartyProject)' == 'True' and '$(RuntimeIdentifier)' != ''">packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(GhostShellFirstPartyProject)' == 'True' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' != ''">packages.$(RuntimeIdentifiers).lock.json</NuGetLockFilePath>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <GhostShellRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</GhostShellRepositoryRoot>
    <PathMap>$(GhostShellRepositoryRoot)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup Condition="'$(GhostShellFirstPartyProject)' == 'True'">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhostShellFirstPartyProject)' == 'True' and '$(GhostShellReleaseSourceManifestSha256)' != ''">
    <AssemblyMetadata
        Include="GhostShellReleaseSourceManifestSha256"
        Value="$(GhostShellReleaseSourceManifestSha256)" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'GhostShell.Core' or
                        '$(MSBuildProjectName)' == 'GhostShell.Protocol' or
                        '$(MSBuildProjectName)' == 'GhostShell.Application' or
                        '$(MSBuildProjectName)' == 'GhostShell.Agent'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)config/BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests'))">
    <PackageReference
      Include="xunit.analyzers"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <None
      Include="$(MSBuildThisFileDirectory)tests/xunit.runner.json"
      Link="xunit.runner.json"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Release packaging must not pass the standard Version properties as global
    MSBuild properties: global values flow through ProjectReference edges and
    would overwrite the independently versioned vendored Exclr8CEF projects.
    Map the product-specific input only for first-party GhostShell assemblies.
  -->
  <PropertyGroup Condition="'$(GhostShellProductVersion)' != '' and $([System.String]::Copy('$(MSBuildProjectName)').StartsWith('GhostShell'))">
    <Version>$(GhostShellProductVersion)</Version>
    <AssemblyVersion>$(GhostShellProductVersion)</AssemblyVersion>
    <FileVersion>$(GhostShellProductVersion)</FileVersion>
    <InformationalVersion>$(GhostShellProductVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
