<UserControl
    x:Class="Asura.DesignQa.WebsiteDummyRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:local="using:Asura.DesignQa"
    x:DataType="local:WebsiteDummyRuntimePanelViewModel"
    Focusable="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <Grid>
    <controls:PanelChrome
        HasAttention="{Binding HasAttention}"
        IsActive="{Binding IsActive}"
        IsAgentActive="{Binding IsAgentActive}"
        IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
        IsVisible="{Binding ShowsTerminal}"
        IsZoomed="{Binding IsZoomed}"
        Title="{Binding Title}">
      <controls:PanelChrome.Status>
        <Border Classes="StatusDot" Background="{DynamicResource ShellSuccessBrush}" />
      </controls:PanelChrome.Status>

      <Grid Background="{DynamicResource ShellBackgroundBrush}" RowDefinitions="*,Auto">
        <StackPanel Margin="{controls:Inset Xl}" Spacing="{DynamicResource ShellSpaceSm}">
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Foreground="{DynamicResource ShellMutedBrush}" Text="Last login: Thu Aug 20 22:38:14 on ttys004" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Text="deploy@production-api:~$ systemctl status asura-api" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Foreground="{DynamicResource ShellSuccessBrush}" Text="● asura-api.service — Asura production API" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Text="     Loaded: loaded (/etc/systemd/system/asura-api.service; enabled)" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Text="     Active: active (running) since Thu 2026-08-20 21:04:18 UTC" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Foreground="{DynamicResource ShellMutedBrush}" Text="   Main PID: 1842 (dotnet) · Tasks: 24 · Memory: 186.4M" />
          <TextBlock Margin="{controls:Inset Top=Md}" FontFamily="{DynamicResource ShellDataFontFamily}" Text="deploy@production-api:~$ tail -n 4 /var/log/asura/api.log" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Foreground="{DynamicResource ShellMutedBrush}" Text="22:41:03 INF request completed  GET /health             200  12ms" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Foreground="{DynamicResource ShellMutedBrush}" Text="22:41:07 INF deployment healthy  release=2026.08.20.4" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Foreground="{DynamicResource ShellMutedBrush}" Text="22:41:12 INF request completed  GET /api/workspaces     200  31ms" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" Text="deploy@production-api:~$ _" />
        </StackPanel>
        <Border Grid.Row="1" Padding="{controls:Inset Horizontal=Md, Vertical=Sm}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="Muted" FontFamily="{DynamicResource ShellDataFontFamily}" FontSize="{DynamicResource ShellFontSize9}" Text="SSH · deploy@10.0.1.42" />
            <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Connected · UTF-8" />
          </Grid>
        </Border>
      </Grid>
    </controls:PanelChrome>

    <controls:PanelChrome
        HasAttention="{Binding HasAttention}"
        IsActive="{Binding IsActive}"
        IsAgentActive="{Binding IsAgentActive}"
        IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
        IsVisible="{Binding ShowsBrowser}"
        IsZoomed="{Binding IsZoomed}"
        Title="{Binding Title}">
      <controls:PanelChrome.Status>
        <Border Classes="StatusDot" Background="{DynamicResource ShellSuccessBrush}" />
      </controls:PanelChrome.Status>

      <controls:PanelChrome.Leading>
        <components:PanelConnectionSelectorView
            IsHitTestVisible="False"
            SelectedLabel="{Binding ConnectionDisplayName}" />
      </controls:PanelChrome.Leading>

      <controls:PanelChrome.HeaderContent>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
          <Button Classes="IconButton" IsHitTestVisible="False">
            <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize13}" Symbol="ArrowLeft" />
          </Button>
          <Button Grid.Column="1" Classes="IconButton" IsHitTestVisible="False">
            <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize13}" Symbol="ArrowRight" />
          </Button>
          <TextBox
              Grid.Column="2"
              VerticalAlignment="Center"
              FontSize="{DynamicResource ShellFontSize10}"
              IsHitTestVisible="False"
              IsReadOnly="True"
              Text="{Binding BrowserAddress}" />
          <Button Grid.Column="3" Classes="IconButton" IsHitTestVisible="False">
            <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize13}" Symbol="ArrowClockwise" />
          </Button>
        </Grid>
      </controls:PanelChrome.HeaderContent>

      <controls:PanelChrome.Footer>
        <TextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize9}"
            Text="Ready" />
      </controls:PanelChrome.Footer>

      <Border Margin="{DynamicResource ShellHairline}" Background="#D0D0D0">
        <StackPanel
            MaxWidth="700"
            Margin="0,120,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="{DynamicResource ShellSpaceMd}">
          <TextBlock
              FontFamily="Arial, sans-serif"
              FontSize="24"
              FontWeight="Bold"
              Foreground="#282828"
              Text="Example Domain" />
          <TextBlock
              FontFamily="Arial, sans-serif"
              FontSize="15"
              Foreground="#282828"
              Text="This domain is for use in documentation examples without needing permission. Avoid use in operations."
              TextWrapping="Wrap" />
          <TextBlock
              FontFamily="Arial, sans-serif"
              FontSize="15"
              Foreground="#42558C"
              Text="Learn more"
              TextDecorations="Underline" />
        </StackPanel>
      </Border>
    </controls:PanelChrome>
  </Grid>
</UserControl>
