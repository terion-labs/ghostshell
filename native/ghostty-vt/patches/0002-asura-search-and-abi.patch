diff --git a/include/ghostty/vt/search.h b/include/ghostty/vt/search.h
new file mode 100644
index 0000000..d1f0210
--- /dev/null
+++ b/include/ghostty/vt/search.h
@@ -0,0 +1,67 @@
+/**
+ * @file search.h
+ *
+ * Bounded terminal search backed by Ghostty's canonical ScreenSearch.
+ */
+
+#ifndef GHOSTTY_VT_SEARCH_H
+#define GHOSTTY_VT_SEARCH_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <ghostty/vt/terminal.h>
+#include <ghostty/vt/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Hard ceiling for results retained by one bounded search. */
+#define GHOSTTY_TERMINAL_SEARCH_MAX_MATCHES 4096u
+
+/** Options for a synchronous, bounded search of the active screen. */
+typedef struct {
+  /** Size of this struct in bytes. */
+  size_t size;
+  /** UTF-8 query bytes. Search uses Ghostty's ASCII case-folding semantics. */
+  GhosttyString query;
+  /** Requested match in newest-to-oldest order; out-of-range values wrap. */
+  int64_t requested_match_index;
+  /** Result ceiling, from 1 through GHOSTTY_TERMINAL_SEARCH_MAX_MATCHES. */
+  size_t max_matches;
+} GhosttyTerminalSearchOptions;
+
+/** Result of a bounded terminal search. */
+typedef struct {
+  /** Size of this struct in bytes. */
+  size_t size;
+  /** Exact count unless scan_truncated is true, then the configured ceiling. */
+  size_t match_count;
+  /** Selected zero-based match, or SIZE_MAX when there is no match. */
+  size_t selected_match_index;
+  /** More terminal history may contain matches beyond match_count. */
+  bool scan_truncated;
+} GhosttyTerminalSearchResult;
+
+/**
+ * Search active content and scrollback using Ghostty ScreenSearch.
+ *
+ * Wrapped rows and matches spanning page boundaries follow Ghostty's own
+ * terminal semantics. On success the selected match becomes the terminal's
+ * active selection and the viewport is moved only when that match is not
+ * already visible. An empty query clears the active selection.
+ *
+ * The call is synchronous and must be serialized with terminal mutation.
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_search(
+    GhosttyTerminal terminal,
+    const GhosttyTerminalSearchOptions* options,
+    GhosttyTerminalSearchResult* out_result);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* GHOSTTY_VT_SEARCH_H */
