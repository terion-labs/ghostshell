diff --git a/src/terminal/c/search.zig b/src/terminal/c/search.zig
new file mode 100644
index 0000000..ef262ba
--- /dev/null
+++ b/src/terminal/c/search.zig
@@ -0,0 +1,173 @@
+const std = @import("std");
+const lib = @import("../lib.zig");
+const Search = @import("../search/screen.zig").ScreenSearch;
+const Selection = @import("../Selection.zig");
+const kitty_c = @import("kitty_graphics.zig");
+const Result = @import("result.zig").Result;
+const terminal_c = @import("terminal.zig");
+
+const maximum_matches: usize = 4096;
+
+/// C: GhosttyTerminalSearchOptions
+pub const Options = extern struct {
+    size: usize = @sizeOf(Options),
+    query: lib.String,
+    requested_match_index: i64 = 0,
+    max_matches: usize = maximum_matches,
+};
+
+/// C: GhosttyTerminalSearchResult
+pub const SearchResult = extern struct {
+    size: usize = @sizeOf(SearchResult),
+    match_count: usize = 0,
+    selected_match_index: usize = std.math.maxInt(usize),
+    scan_truncated: bool = false,
+};
+
+comptime {
+    if (@sizeOf(Options) != 40) @compileError("GhosttyTerminalSearchOptions ABI changed");
+    if (@sizeOf(SearchResult) != 32) @compileError("GhosttyTerminalSearchResult ABI changed");
+    if (@sizeOf(terminal_c.SemanticPromptEvent) != 24) @compileError("GhosttyTerminalSemanticPromptEvent ABI changed");
+    if (@sizeOf(kitty_c.VirtualPlacementRenderInfo) != 64) @compileError("GhosttyKittyGraphicsVirtualPlacementRenderInfo ABI changed");
+}
+
+pub fn terminalSearch(
+    terminal: terminal_c.Terminal,
+    options_: ?*const Options,
+    out_result_: ?*SearchResult,
+) callconv(lib.calling_conv) Result {
+    const t = terminal_c.zigTerminal(terminal) orelse return .invalid_value;
+    const options = options_ orelse return .invalid_value;
+    if (options.size < @sizeOf(Options)) return .invalid_value;
+    const out_result = out_result_ orelse return .invalid_value;
+    if (out_result.size < @sizeOf(SearchResult)) return .invalid_value;
+    if (options.query.len > 0 and @intFromPtr(options.query.ptr) == 0) {
+        return .invalid_value;
+    }
+    if (options.max_matches == 0 or options.max_matches > maximum_matches) {
+        return .invalid_value;
+    }
+
+    out_result.* = .{};
+    const screen = t.screens.active;
+    const query = if (options.query.len == 0)
+        ""
+    else
+        options.query.ptr[0..options.query.len];
+    if (query.len == 0) {
+        screen.clearSelection();
+        return .success;
+    }
+
+    const alloc = t.gpa();
+    var search = Search.init(alloc, screen, query) catch return .out_of_memory;
+    defer search.deinit();
+
+    var complete = false;
+    while (search.matchesLen() <= options.max_matches) {
+        search.tick() catch |err| switch (err) {
+            error.OutOfMemory => return .out_of_memory,
+            error.FeedRequired => {
+                search.feed() catch return .out_of_memory;
+            },
+            error.SearchComplete => {
+                complete = true;
+                break;
+            },
+        };
+    }
+
+    const found = search.matchesLen();
+    const count = @min(found, options.max_matches);
+    out_result.match_count = count;
+    out_result.scan_truncated = !complete or found > options.max_matches;
+    if (count == 0) {
+        screen.clearSelection();
+        return .success;
+    }
+
+    const count_i64: i64 = @intCast(count);
+    const requested = @mod(options.requested_match_index, count_i64);
+    const selected_index: usize = @intCast(requested);
+    const active_len = search.active_results.items.len;
+    const match = if (selected_index < active_len)
+        search.active_results.items[active_len - 1 - selected_index]
+    else
+        search.history_results.items[selected_index - active_len];
+    const untracked = match.untracked();
+
+    screen.select(Selection.init(untracked.start, untracked.end, false)) catch
+        return .out_of_memory;
+    out_result.selected_match_index = selected_index;
+
+    // Preserve Ghostty's normal search navigation: keep the viewport still
+    // when the match is already visible, otherwise pin it to the match start.
+    var viewport = screen.pages.pageIterator(
+        .right_down,
+        .{ .viewport = .{} },
+        null,
+    );
+    const match_chunks = match.chunks.slice();
+    while (viewport.next()) |chunk| {
+        for (0..match_chunks.len) |i| {
+            const match_chunk = match_chunks.get(i);
+            if (chunk.overlaps(.{
+                .node = match_chunk.node,
+                .start = match_chunk.start,
+                .end = match_chunk.end,
+            })) return .success;
+        }
+    }
+
+    screen.scroll(.{ .pin = match.startPin() });
+    return .success;
+}
+
+test "search covers scrollback, wrapped rows, selection, and bounds" {
+    const testing = std.testing;
+    var terminal: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(null, &terminal, 8, 2));
+    defer terminal_c.free(terminal);
+
+    const bytes =
+        "old wrapped-needle\r\n" ++
+        "middle\r\n" ++
+        "wrapped-needle new\r\n" ++
+        "wrapped-needle latest";
+    terminal_c.vt_write(terminal, bytes.ptr, bytes.len);
+
+    var options: Options = .{
+        .query = .{ .ptr = "wrapped-needle", .len = "wrapped-needle".len },
+        .requested_match_index = 1,
+        .max_matches = 2,
+    };
+    var result: SearchResult = .{};
+    try testing.expectEqual(Result.success, terminalSearch(terminal, &options, &result));
+    try testing.expectEqual(@as(usize, 2), result.match_count);
+    try testing.expectEqual(@as(usize, 1), result.selected_match_index);
+    try testing.expect(result.scan_truncated);
+    try testing.expect(terminal_c.zigTerminal(terminal).?.screens.active.selection != null);
+
+    options.query = .{ .ptr = "", .len = 0 };
+    try testing.expectEqual(Result.success, terminalSearch(terminal, &options, &result));
+    try testing.expectEqual(@as(usize, 0), result.match_count);
+    try testing.expectEqual(std.math.maxInt(usize), result.selected_match_index);
+    try testing.expect(!result.scan_truncated);
+    try testing.expect(terminal_c.zigTerminal(terminal).?.screens.active.selection == null);
+}
+
+test "search rejects an unbounded result request" {
+    var terminal: terminal_c.Terminal = null;
+    try std.testing.expectEqual(Result.success, terminal_c.new(null, &terminal, 8, 2));
+    defer terminal_c.free(terminal);
+
+    var options: Options = .{
+        .query = .{ .ptr = "x", .len = 1 },
+        .max_matches = maximum_matches + 1,
+    };
+    var result: SearchResult = .{};
+    try std.testing.expectEqual(
+        Result.invalid_value,
+        terminalSearch(terminal, &options, &result),
+    );
+}
