+/**
+ * Renderer-ready geometry for a Unicode Kitty virtual placement.
+ *
+ * This struct is produced from Ghostty's canonical Unicode placeholder
+ * iterator and virtual-placement renderer. Initialize with
+ * GHOSTTY_INIT_SIZED(GhosttyKittyGraphicsVirtualPlacementRenderInfo) before
+ * calling ghostty_kitty_graphics_virtual_placement_next(). The image pixels and
+ * generation can be queried with the returned `image_id` through the existing
+ * GhosttyKittyGraphicsImage APIs.
+ *
+ * @ingroup kitty_graphics
+ */
+typedef struct {
+  /** Size of this struct in bytes. */
+  size_t size;
+  /** Image ID encoded by the placeholder. */
+  uint32_t image_id;
+  /** Placement ID encoded by the placeholder, or zero when omitted. */
+  uint32_t placement_id;
+  /** Viewport-relative destination column. */
+  int32_t viewport_col;
+  /** Viewport-relative destination row. */
+  int32_t viewport_row;
+  /** Rendering layer. Unicode virtual placements are currently -1. */
+  int32_t z;
+  /** Pixel offset from the destination cell's left edge. */
+  uint32_t cell_offset_x;
+  /** Pixel offset from the destination cell's top edge. */
+  uint32_t cell_offset_y;
+  /** Source rectangle x origin in image pixels. */
+  uint32_t source_x;
+  /** Source rectangle y origin in image pixels. */
+  uint32_t source_y;
+  /** Source rectangle width in image pixels. */
+  uint32_t source_width;
+  /** Source rectangle height in image pixels. */
+  uint32_t source_height;
+  /** Destination width in pixels. */
+  uint32_t dest_width;
+  /** Destination height in pixels. */
+  uint32_t dest_height;
+} GhosttyKittyGraphicsVirtualPlacementRenderInfo;
+
 /**
  * Get data from a kitty graphics storage instance.
  *
@@ -590,6 +636,77 @@ GHOSTTY_API GhosttyResult ghostty_kitty_graphics_placement_iterator_new(
 GHOSTTY_API void ghostty_kitty_graphics_placement_iterator_free(
     GhosttyKittyGraphicsPlacementIterator iterator);

+/**
+ * Create a reusable Unicode Kitty virtual-placement iterator.
+ *
+ * The iterator is inert until reset for a terminal viewport with
+ * ghostty_kitty_graphics_virtual_placement_iterator_reset().
+ *
+ * @param allocator Pointer to allocator, or NULL to use the default allocator
+ * @param[out] out_iterator On success, receives the created iterator handle
+ * @return GHOSTTY_SUCCESS on success
+ *
+ * @ingroup kitty_graphics
+ */
+GHOSTTY_API GhosttyResult
+ghostty_kitty_graphics_virtual_placement_iterator_new(
+    const GhosttyAllocator* allocator,
+    GhosttyKittyGraphicsVirtualPlacementIterator* out_iterator);
+
+/**
+ * Free a Unicode Kitty virtual-placement iterator.
+ *
+ * @param iterator The iterator handle to free (may be NULL)
+ *
+ * @ingroup kitty_graphics
+ */
+GHOSTTY_API void ghostty_kitty_graphics_virtual_placement_iterator_free(
+    GhosttyKittyGraphicsVirtualPlacementIterator iterator);
+
+/**
+ * Reset an iterator to the terminal's active viewport.
+ *
+ * The iterator borrows terminal page-list state. Any mutating terminal call,
+ * including ghostty_terminal_vt_write(), resize, reset, or screen switching,
+ * invalidates the iteration. Reset it again before requesting another item.
+ * The cell dimensions must match the renderer's current cell size.
+ *
+ * @param iterator The iterator handle
+ * @param terminal The terminal whose active viewport should be enumerated
+ * @param cell_width Cell width in pixels (must be non-zero)
+ * @param cell_height Cell height in pixels (must be non-zero)
+ * @return GHOSTTY_SUCCESS on success, GHOSTTY_INVALID_VALUE for invalid
+ *         arguments, or GHOSTTY_NO_VALUE when no viewport exists
+ *
+ * @ingroup kitty_graphics
+ */
+GHOSTTY_API GhosttyResult
+ghostty_kitty_graphics_virtual_placement_iterator_reset(
+    GhosttyKittyGraphicsVirtualPlacementIterator iterator,
+    GhosttyTerminal terminal,
+    uint32_t cell_width,
+    uint32_t cell_height);
+
+/**
+ * Produce the next renderer-ready Unicode Kitty virtual placement.
+ *
+ * Missing images, malformed placeholder fragments, and placements that resolve
+ * to an empty destination are skipped, matching Ghostty renderer behavior.
+ * Initialize `out_info` with
+ * GHOSTTY_INIT_SIZED(GhosttyKittyGraphicsVirtualPlacementRenderInfo).
+ *
+ * @param iterator An iterator previously reset for the current terminal state
+ * @param[out] out_info Renderer-ready placement geometry
+ * @return GHOSTTY_SUCCESS when a placement was written, GHOSTTY_NO_VALUE at
+ *         normal exhaustion, or GHOSTTY_INVALID_VALUE for invalid arguments or
+ *         an iterator that has not been reset
+ *
+ * @ingroup kitty_graphics
+ */
+GHOSTTY_API GhosttyResult ghostty_kitty_graphics_virtual_placement_next(
+    GhosttyKittyGraphicsVirtualPlacementIterator iterator,
+    GhosttyKittyGraphicsVirtualPlacementRenderInfo* out_info);
+
