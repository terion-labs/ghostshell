+
+/// A renderer-ready Unicode Kitty virtual placement. This is derived using
+/// Ghostty's canonical placeholder iterator and Placement.renderPlacement.
+/// C: GhosttyKittyGraphicsVirtualPlacementRenderInfo
+pub const VirtualPlacementRenderInfo = extern struct {
+    size: usize = @sizeOf(VirtualPlacementRenderInfo),
+    image_id: u32 = 0,
+    placement_id: u32 = 0,
+    viewport_col: i32 = 0,
+    viewport_row: i32 = 0,
+    z: i32 = -1,
+    cell_offset_x: u32 = 0,
+    cell_offset_y: u32 = 0,
+    source_x: u32 = 0,
+    source_y: u32 = 0,
+    source_width: u32 = 0,
+    source_height: u32 = 0,
+    dest_width: u32 = 0,
+    dest_height: u32 = 0,
+};
+
 /// C: GhosttyKittyGraphicsData
 pub const Data = enum(c_int) {
     invalid = 0,
@@ -293,6 +331,118 @@ pub fn placement_iterator_free(iter_: PlacementIterator) callconv(lib.calling_co
     iter.alloc.destroy(iter);
 }

+pub fn virtual_placement_iterator_new(
+    alloc_: ?*const CAllocator,
+    out: *VirtualPlacementIterator,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) {
+        out.* = null;
+        return .no_value;
+    }
+
+    const alloc = lib.alloc.default(alloc_);
+    const ptr = alloc.create(VirtualPlacementIteratorWrapper) catch {
+        out.* = null;
+        return .out_of_memory;
+    };
+    ptr.* = .{ .alloc = alloc };
+    out.* = ptr;
+    return .success;
+}
+
+pub fn virtual_placement_iterator_free(
+    iter_: VirtualPlacementIterator,
+) callconv(lib.calling_conv) void {
+    if (comptime !build_options.kitty_graphics) return;
+    const iter = iter_ orelse return;
+    iter.alloc.destroy(iter);
+}
+
+/// Reset a reusable virtual-placement iterator to the active viewport. The
+/// caller must reset after every mutating terminal call; the iterator's pins
+/// borrow page-list state owned by the terminal.
+pub fn virtual_placement_iterator_reset(
+    iter_: VirtualPlacementIterator,
+    terminal_: terminal_c.Terminal,
+    cell_width: u32,
+    cell_height: u32,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const iter = iter_ orelse return .invalid_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (cell_width == 0 or cell_height == 0) return .invalid_value;
+
+    const pages = &wrapper.terminal.screens.active.pages;
+    const top = pages.getTopLeft(.viewport);
+    const bottom = pages.getBottomRight(.viewport) orelse {
+        iter.terminal = terminal_;
+        iter.inner = null;
+        iter.cell_width = cell_width;
+        iter.cell_height = cell_height;
+        return .no_value;
+    };
+
+    iter.terminal = terminal_;
+    iter.inner = kitty_unicode.placementIterator(top, bottom);
+    iter.cell_width = cell_width;
+    iter.cell_height = cell_height;
+    return .success;
+}
+
+/// Return the next renderer-ready virtual placement. Invalid or missing
+/// backing images and placements are skipped exactly as Ghostty's renderer
+/// skips them. GHOSTTY_NO_VALUE signals normal iterator exhaustion.
+pub fn virtual_placement_iterator_next(
+    iter_: VirtualPlacementIterator,
+    out_: ?*VirtualPlacementRenderInfo,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const iter = iter_ orelse return .invalid_value;
+    const wrapper = iter.terminal orelse return .invalid_value;
+    const inner = if (iter.inner) |*value| value else return .invalid_value;
+    const out = out_ orelse return .invalid_value;
+    if (out.size < @sizeOf(VirtualPlacementRenderInfo)) return .invalid_value;
+
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    while (inner.next()) |placement| {
+        const image = storage.imageById(placement.image_id) orelse continue;
+        const render = placement.renderPlacement(
+            storage,
+            &image,
+            iter.cell_width,
+            iter.cell_height,
+        ) catch continue;
+        if (render.dest_width == 0 or render.dest_height == 0) continue;
+
+        const viewport = t.screens.active.pages.pointFromPin(
+            .viewport,
+            render.top_left,
+        ) orelse continue;
+
+        out.* = .{
+            .image_id = placement.image_id,
+            .placement_id = placement.placement_id,
+            .viewport_col = @intCast(render.top_left.x),
+            .viewport_row = @intCast(viewport.viewport.y),
+            .z = -1,
+            .cell_offset_x = render.offset_x,
+            .cell_offset_y = render.offset_y,
+            .source_x = render.source_x,
+            .source_y = render.source_y,
+            .source_width = render.source_width,
+            .source_height = render.source_height,
+            .dest_width = render.dest_width,
+            .dest_height = render.dest_height,
+        };
+        return .success;
+    }
+
+    return .no_value;
+}
