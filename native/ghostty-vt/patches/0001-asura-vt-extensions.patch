+test "set semantic_prompt callback normalizes OSC 133 lifecycle" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(
+        &lib.alloc.test_allocator,
+        &t,
+        80,
+        24,
+    ));
+    defer free(t);
+
+    const S = struct {
+        var count: usize = 0;
+        var events: [8]SemanticPromptEvent = undefined;
+        var last_terminal: Terminal = null;
+        var last_userdata: ?*anyopaque = null;
+
+        fn semanticPrompt(
+            terminal_: Terminal,
+            ud: ?*anyopaque,
+            event: *const SemanticPromptEvent,
+        ) callconv(lib.calling_conv) void {
+            last_terminal = terminal_;
+            last_userdata = ud;
+            events[count] = event.*;
+            count += 1;
+        }
+    };
+    S.count = 0;
+    S.last_terminal = null;
+    S.last_userdata = null;
+
+    var sentinel: u8 = 101;
+    try testing.expectEqual(Result.success, set(t, .userdata, @ptrCast(&sentinel)));
+    try testing.expectEqual(Result.success, set(
+        t,
+        .semantic_prompt,
+        @ptrCast(&S.semanticPrompt),
+    ));
+
+    // Split a full lifecycle across write boundaries to exercise the persistent
+    // parser and prove delivery remains synchronous with the completing write.
+    const first = "\x1B]133;A\x1B\\\x1B]133;B\x1B\\\x1B]133;C";
+    vt_write(t, first.ptr, first.len);
+    try testing.expectEqual(@as(usize, 2), S.count);
+    const second = "\x1B\\\x1B]133;D;12;aid=test\x07";
+    vt_write(t, second.ptr, second.len);
+    try testing.expectEqual(@as(usize, 4), S.count);
+
+    try testing.expectEqual(t, S.last_terminal);
+    try testing.expectEqual(@as(?*anyopaque, @ptrCast(&sentinel)), S.last_userdata);
+    try testing.expectEqual(SemanticPromptPhase.prompt, S.events[0].phase);
+    try testing.expectEqual(SemanticPromptPhase.input, S.events[1].phase);
+    try testing.expectEqual(SemanticPromptPhase.executed, S.events[2].phase);
+    try testing.expectEqual(SemanticPromptPhase.finished, S.events[3].phase);
+    for (S.events[0..4]) |event| {
+        try testing.expectEqual(@sizeOf(SemanticPromptEvent), event.size);
+    }
+    try testing.expect(!S.events[0].has_exit_status);
+    try testing.expect(!S.events[1].has_exit_status);
+    try testing.expect(!S.events[2].has_exit_status);
+    try testing.expect(S.events[3].has_exit_status);
+    try testing.expectEqual(@as(i32, 12), S.events[3].exit_status);
+
+    // Alternate prompt/input spellings normalize to the same phases, while L
+    // is only a terminal-state operation and intentionally emits no event.
+    const aliases = "\x1B]133;L\x1B\\\x1B]133;N\x1B\\\x1B]133;I\x1B\\";
+    vt_write(t, aliases.ptr, aliases.len);
+    try testing.expectEqual(@as(usize, 6), S.count);
+    try testing.expectEqual(SemanticPromptPhase.prompt, S.events[4].phase);
+    try testing.expectEqual(SemanticPromptPhase.input, S.events[5].phase);
+
+    try testing.expectEqual(Result.success, set(t, .semantic_prompt, null));
+    const ignored = "\x1B]133;D;0\x1B\\";
+    vt_write(t, ignored.ptr, ignored.len);
+    try testing.expectEqual(@as(usize, 6), S.count);
+}
