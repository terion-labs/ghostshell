@@ -543,6 +544,72 @@ typedef void (*GhosttyTerminalProgressReportFn)(
     void* userdata,
     const GhosttyTerminalProgressReport* report);

+/**
+ * Normalized phase of a shell-integration command lifecycle.
+ *
+ * Multiple OSC 133 actions that express the same lifecycle transition are
+ * intentionally collapsed into these four phases. OSC 133;L, which only
+ * requests a fresh line, does not emit an event.
+ *
+ * @ingroup terminal
+ */
+typedef enum GHOSTTY_ENUM_TYPED {
+  /** A new prompt is being drawn (OSC 133 A, N, or P). */
+  GHOSTTY_TERMINAL_SEMANTIC_PROMPT_PHASE_PROMPT = 0,
+
+  /** Prompt rendering finished and user input began (OSC 133 B or I). */
+  GHOSTTY_TERMINAL_SEMANTIC_PROMPT_PHASE_INPUT = 1,
+
+  /** User input finished and command output began (OSC 133 C). */
+  GHOSTTY_TERMINAL_SEMANTIC_PROMPT_PHASE_EXECUTED = 2,
+
+  /** The command finished (OSC 133 D). */
+  GHOSTTY_TERMINAL_SEMANTIC_PROMPT_PHASE_FINISHED = 3,
+  GHOSTTY_TERMINAL_SEMANTIC_PROMPT_PHASE_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
+} GhosttyTerminalSemanticPromptPhase;
+
+/**
+ * A normalized shell-integration command lifecycle event.
+ *
+ * This is a sized struct. The callback must only access fields present in the
+ * size reported by `size`. `has_exit_status` is only true for a FINISHED event
+ * when OSC 133;D included a parseable exit status.
+ *
+ * @ingroup terminal
+ */
+typedef struct {
+  /** Size of this struct in bytes. */
+  size_t size;
+
+  /** Normalized lifecycle phase. */
+  GhosttyTerminalSemanticPromptPhase phase;
+
+  /** Whether `exit_status` contains a value. */
+  bool has_exit_status;
+
+  /** Command exit status when `has_exit_status` is true. */
+  int32_t exit_status;
+} GhosttyTerminalSemanticPromptEvent;
+
+/**
+ * Callback function type for normalized OSC 133 shell-integration events.
+ *
+ * Called synchronously, after the OSC 133 action has been successfully applied
+ * to Ghostty terminal state. The event is borrowed for the callback duration.
+ * Like all terminal effects, the callback must not re-enter
+ * ghostty_terminal_vt_write() for the same terminal.
+ *
+ * @param terminal The terminal handle
+ * @param userdata The userdata pointer set via GHOSTTY_TERMINAL_OPT_USERDATA
+ * @param event Borrowed normalized lifecycle event
+ *
+ * @ingroup terminal
+ */
+typedef void (*GhosttyTerminalSemanticPromptFn)(
+    GhosttyTerminal terminal,
+    void* userdata,
+    const GhosttyTerminalSemanticPromptEvent* event);
+
 /**
  * Callback function type for color scheme queries (CSI ? 996 n).
  *
@@ -1027,6 +1094,15 @@ typedef enum GHOSTTY_ENUM_TYPED {
    * Input type: GhosttyTerminalProgressReportFn
    */
   GHOSTTY_TERMINAL_OPT_PROGRESS_REPORT = 30,
+
+  /**
+   * Callback invoked after a shell-integration OSC 133 action changes the
+   * semantic command lifecycle. OSC 133;L does not emit an event. Set to NULL
+   * to ignore semantic prompt events.
+   *
+   * Input type: GhosttyTerminalSemanticPromptFn
+   */
+  GHOSTTY_TERMINAL_OPT_SEMANTIC_PROMPT = 31,
   GHOSTTY_TERMINAL_OPT_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
 } GhosttyTerminalOption;

